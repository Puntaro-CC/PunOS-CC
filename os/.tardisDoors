-- PunOS TARDIS Doors
-- Control internal and external door state and locks.

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local monitor, tardis = dofile("/os/loadPeripherals.lua")
local w, h = term.getSize()

local tardisOk = (tardis ~= nil)

local function safe(fn, ...)
    if not tardisOk then return nil end
    local ok, r = pcall(fn, ...)
    return ok and r or nil
end

local function safeMulti(fn, ...)
    if not tardisOk then return nil end
    local ok, a, b, c, d, e = pcall(fn, ...)
    if ok then return a, b, c, d, e end
    return nil
end

local statusMsg = ""
local statusCol = nil
local btnDefs   = {}

-- ---- Header -----------------------------------------------------------------

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1)
    term.setTextColor(UI.primary)
    term.write("PunOS  TARDIS Doors")
    term.setCursorPos(w - 9, 1)
    term.setBackgroundColor(UI.border)
    term.setTextColor(tardisOk and UI.success or UI.error)
    term.write(tardisOk and "  ONLINE" or " NO SIG ")
    term.setCursorPos(2, 2)
    term.setTextColor(UI.subtext)
    term.write("Manage door open/closed and lock states")
end

-- ---- Status panel -----------------------------------------------------------

local function drawDoorStatus()
    paintutils.drawFilledBox(1, 3, w, 3, UI.border)
    term.setCursorPos(2, 3)
    term.setBackgroundColor(UI.border)
    term.setTextColor(UI.primary)
    term.write("DOOR STATUS")

    if not tardisOk then
        term.setCursorPos(2, 4)
        term.setBackgroundColor(UI.background)
        term.setTextColor(UI.error)
        term.write("No TARDIS peripheral detected.")
        return
    end

    local intOpen        = safe(tardis.getInternalDoorOpen)
    local intLock, extLock = safeMulti(tardis.getDoorLocked)

    -- Internal door
    local intY = 5
    paintutils.drawFilledBox(2, intY, w - 1, intY + 4, UI.border)
    paintutils.drawFilledBox(2, intY, w - 1, intY, UI.primary)
    term.setCursorPos(3, intY)
    term.setBackgroundColor(UI.primary)
    term.setTextColor(UI.fgDark)
    term.write("INTERNAL DOOR")

    term.setBackgroundColor(UI.border)
    term.setCursorPos(3, intY + 1)
    term.setTextColor(UI.subtext)
    term.write("State  ")
    term.setTextColor(intOpen and UI.error or UI.success)
    term.write(intOpen and "Open" or "Closed")

    term.setCursorPos(3, intY + 2)
    term.setTextColor(UI.subtext)
    term.write("Lock   ")
    term.setTextColor(intLock and UI.error or UI.success)
    term.write(intLock and "Locked" or "Unlocked")

    term.setCursorPos(3, intY + 3)
    term.setTextColor(UI.subtext)
    term.write("Note: setDoorLocked always closes doors first.")

    -- External lock
    local extY = intY + 6
    paintutils.drawFilledBox(2, extY, w - 1, extY + 3, UI.border)
    paintutils.drawFilledBox(2, extY, w - 1, extY, UI.primary)
    term.setCursorPos(3, extY)
    term.setBackgroundColor(UI.primary)
    term.setTextColor(UI.fgDark)
    term.write("EXTERNAL DOOR")

    term.setBackgroundColor(UI.border)
    term.setCursorPos(3, extY + 1)
    term.setTextColor(UI.subtext)
    term.write("Lock   ")
    term.setTextColor(extLock and UI.error or UI.success)
    term.write(extLock and "Locked" or "Unlocked")

    term.setCursorPos(3, extY + 2)
    term.setTextColor(UI.subtext)
    term.write("External lock controlled via setDoorLocked.")
end

-- ---- Buttons ----------------------------------------------------------------

local function drawButtons()
    btnDefs = {}

    if not tardisOk then
        return
    end

    local intOpen        = safe(tardis.getInternalDoorOpen)
    local intLock, extLock = safeMulti(tardis.getDoorLocked)

    local row = h - 2
    paintutils.drawFilledBox(1, row - 1, w, row - 1, UI.border)
    term.setBackgroundColor(UI.background)
    term.setCursorPos(1, row); term.clearLine()
    term.setCursorPos(1, h);   term.clearLine()

    local btns = {
        {
            label  = intOpen and " Close Door " or " Open Door ",
            col    = intOpen and UI.error or UI.success,
            action = function()
                pcall(tardis.setDoorClosed, intOpen)
                statusMsg = intOpen and "Door closed." or "Door opened."
                statusCol = UI.subtext
            end,
        },
        {
            label  = intLock and " Unlock Doors " or " Lock Doors ",
            col    = intLock and UI.error or UI.primary,
            action = function()
                pcall(tardis.setDoorLocked, not intLock)
                statusMsg = intLock and "Doors unlocked." or "Doors locked."
                statusCol = UI.subtext
            end,
        },
        {
            label  = " Back ",
            col    = UI.border,
            action = "back",
        },
    }

    local x = 2
    for _, btn in ipairs(btns) do
        local x2 = x + #btn.label - 1
        paintutils.drawFilledBox(x, row, x2, row, btn.col)
        term.setCursorPos(x, row)
        term.setBackgroundColor(btn.col)
        term.setTextColor(btn.col == UI.border and UI.text or UI.fgDark)
        term.write(btn.label)
        table.insert(btnDefs, { x1=x, x2=x2, y=row, action=btn.action })
        x = x2 + 2
    end

    if statusMsg ~= "" then
        term.setCursorPos(2, h)
        term.setBackgroundColor(UI.background)
        term.setTextColor(statusCol or UI.subtext)
        term.clearLine()
        term.write(statusMsg)
    end
end

-- ---- Full redraw ------------------------------------------------------------

local function redraw()
    term.setBackgroundColor(UI.background)
    term.clear()
    drawHeader()
    drawDoorStatus()
    drawButtons()
end

-- ---- Entry ------------------------------------------------------------------

redraw()

local pollTimer = os.startTimer(0.5)

local running = true
while running do
    local e, p1, p2, p3 = os.pullEvent()

    if e == "timer" and p1 == pollTimer then
        drawDoorStatus()
        drawButtons()
        pollTimer = os.startTimer(0.5)

    elseif e == "onDoorOpened" or e == "onDoorClosed" then
        drawDoorStatus()
        drawButtons()

    elseif e == "key" and p1 == keys.backspace then
        break

    elseif e == "mouse_click" or e == "monitor_touch" then
        local mx, my = p2, p3
        for _, btn in ipairs(btnDefs) do
            if my == btn.y and mx >= btn.x1 and mx <= btn.x2 then
                if btn.action == "back" then
                    running = false
                else
                    btn.action()
                    drawDoorStatus()
                    drawButtons()
                end
                break
            end
        end
    end
end

term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1, 1)
shell.run(".menu")
