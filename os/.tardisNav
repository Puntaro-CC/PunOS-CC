-- PunOS TARDIS Navigator
-- Set destination, begin/end flight, co-pilot event alerts.

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local monitor, tardis = dofile("/os/loadPeripherals.lua")
local w, h = term.getSize()

local tardisOk = (tardis ~= nil)

local function safe(fn, ...)
    if not tardisOk then return nil end
    local ok, r = pcall(fn, ...)
    return ok and r or nil
end

local function safeMulti(fn, ...)
    if not tardisOk then return nil end
    local ok, a, b, c, d, e = pcall(fn, ...)
    if ok then return a, b, c, d, e end
    return nil
end

local function shortDim(dim)
    if not dim then return "?" end
    return dim:match(":(.+)$") or dim
end

-- ---- State ------------------------------------------------------------------

local fields     = { x = "", y = "", z = "", facing = "" }
local fieldOrder = { "x", "y", "z", "facing" }
local fieldLabels = { x = "X", y = "Y", z = "Z", facing = "Facing" }
local activeField = 1

-- Dimension state
local dimensions   = {}   -- list of dimension strings from getDimensions()
local dimScroll    = 0
local dimSelected  = nil  -- currently chosen dimension string
local dimPickerOpen = false

local copilot    = false
local statusMsg  = ""
local statusCol  = nil
local btnDefs    = {}

-- Load dimension list once
local function loadDimensions()
    local raw = safe(tardis.getDimensions)
    if raw then
        dimensions = raw
        -- Pre-select current target dimension if available
        local cur = safe(tardis.getTargetDimension)
        if cur then dimSelected = cur end
    end
end

-- ---- Header -----------------------------------------------------------------

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1)
    term.setTextColor(UI.primary)
    term.write("PunOS  TARDIS Navigator")
    term.setCursorPos(w - 9, 1)
    term.setBackgroundColor(UI.border)
    term.setTextColor(tardisOk and UI.success or UI.error)
    term.write(tardisOk and "  ONLINE" or " NO SIG ")
    term.setCursorPos(2, 2)
    term.setTextColor(UI.subtext)
    term.write("Set destination and manage flight")
end

-- ---- Current location -------------------------------------------------------

local function drawCurrent()
    paintutils.drawFilledBox(1, 3, w, 3, UI.border)
    term.setCursorPos(2, 3)
    term.setBackgroundColor(UI.border)
    term.setTextColor(UI.primary)
    term.write("CURRENT LOCATION")

    local cx, cy, cz, cFacing, cDim = safeMulti(tardis.getLastKnownLocation)
    term.setCursorPos(2, 4)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.subtext)
    term.write("Pos: ")
    term.setTextColor(UI.text)
    if cx then
        term.write(cx .. " " .. cy .. " " .. cz .. "   ")
        term.setTextColor(UI.subtext)
        term.write("Dim: ")
        term.setTextColor(UI.text)
        term.write(shortDim(cDim) .. "   ")
        term.setTextColor(UI.subtext)
        term.write("Face: ")
        term.setTextColor(UI.text)
        term.write(cFacing or "?")
    else
        term.write("unknown")
    end
end

-- ---- Destination form -------------------------------------------------------

local DIM_PICKER_Y = 9   -- row where dim picker list starts
local DIM_PICKER_H = 5   -- how many entries visible

local function drawForm()
    paintutils.drawFilledBox(1, 6, w, 6, UI.border)
    term.setCursorPos(2, 6)
    term.setBackgroundColor(UI.border)
    term.setTextColor(UI.primary)
    term.write("SET DESTINATION")

    -- Text fields (x, y, z, facing)
    for i, key in ipairs(fieldOrder) do
        local y     = 7 + (i - 1)
        local label = fieldLabels[key]
        local val   = fields[key]
        local isSel = (i == activeField) and not dimPickerOpen

        term.setCursorPos(2, y)
        term.setBackgroundColor(UI.background)
        term.setTextColor(UI.subtext)
        term.write(string.format("%-12s", label .. ": "))

        local fieldW = w - 15
        if isSel then
            paintutils.drawFilledBox(15, y, 15 + fieldW - 1, y, UI.border)
            term.setCursorPos(15, y)
            term.setBackgroundColor(UI.border)
            term.setTextColor(UI.primary)
        else
            paintutils.drawFilledBox(15, y, 15 + fieldW - 1, y, UI.background)
            term.setCursorPos(15, y)
            term.setBackgroundColor(UI.background)
            term.setTextColor(UI.text)
        end
        term.write(val .. (isSel and "_" or ""))
        local rest = fieldW - #val - (isSel and 1 or 0)
        if rest > 0 then term.write(string.rep(" ", rest)) end
    end

    -- Dimension field (row 11) — shows picker instead of free text
    local dimY    = 11
    local dimVal  = dimSelected or "not set"
    local dimIsSel = dimPickerOpen

    term.setCursorPos(2, dimY)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.subtext)
    term.write("Dimension:  ")

    local fieldW = w - 15
    if dimIsSel then
        paintutils.drawFilledBox(15, dimY, 15 + fieldW - 1, dimY, UI.primary)
        term.setCursorPos(15, dimY)
        term.setBackgroundColor(UI.primary)
        term.setTextColor(UI.fgDark)
    else
        paintutils.drawFilledBox(15, dimY, 15 + fieldW - 1, dimY, UI.border)
        term.setCursorPos(15, dimY)
        term.setBackgroundColor(UI.border)
        term.setTextColor(UI.text)
    end
    local dv = dimVal:sub(1, fieldW - 1)
    term.write(dv)
    local rest = fieldW - #dv
    if rest > 0 then term.write(string.rep(" ", rest)) end

    -- Hint below dimension field
    term.setCursorPos(2, dimY + 1)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.subtext)
    term.clearLine()
    if dimPickerOpen then
        term.write("Up/Down: scroll  Enter/Click: select  Esc: close")
    else
        term.write("Click dimension field to open picker")
    end

    -- Dimension picker dropdown
    if dimPickerOpen then
        for i = 1, DIM_PICKER_H do
            local idx = i + dimScroll
            local dim = dimensions[idx]
            local y   = DIM_PICKER_Y + i - 1

            term.setCursorPos(2, y)
            term.setBackgroundColor(UI.background)
            term.clearLine()

            if dim then
                local isSel = (dim == dimSelected)
                if isSel then
                    paintutils.drawFilledBox(2, y, w - 1, y, UI.primary)
                    term.setCursorPos(3, y)
                    term.setBackgroundColor(UI.primary)
                    term.setTextColor(UI.fgDark)
                else
                    term.setCursorPos(3, y)
                    term.setTextColor(UI.text)
                end
                term.write(dim:sub(1, w - 4))
            end
        end

        -- Scroll hints
        if dimScroll > 0 then
            term.setCursorPos(w - 6, DIM_PICKER_Y)
            term.setBackgroundColor(UI.background)
            term.setTextColor(UI.subtext)
            term.write("[^ up]")
        end
        if dimScroll + DIM_PICKER_H < #dimensions then
            term.setCursorPos(w - 8, DIM_PICKER_Y + DIM_PICKER_H - 1)
            term.setBackgroundColor(UI.background)
            term.setTextColor(UI.subtext)
            term.write("[v more]")
        end
    end
end

-- ---- Flight status ----------------------------------------------------------

local STATUS_ROW = 15

local function drawFlightStatus()
    local row = STATUS_ROW

    -- Clear area
    for y = row, h - 4 do
        term.setCursorPos(1, y)
        term.setBackgroundColor(UI.background)
        term.clearLine()
    end

    paintutils.drawFilledBox(1, row, w, row, UI.border)
    term.setCursorPos(2, row)
    term.setBackgroundColor(UI.border)
    term.setTextColor(UI.primary)
    term.write("FLIGHT STATUS")
    row = row + 1

    if not tardisOk then
        term.setCursorPos(2, row)
        term.setBackgroundColor(UI.background)
        term.setTextColor(UI.error)
        term.write("No TARDIS peripheral.")
        return
    end

    local inFlight  = safe(tardis.isInFlight)
    local pct       = safe(tardis.getFlightPercent) or 0
    local canBegin  = safe(tardis.canBeginFlight)
    local canEnd    = safe(tardis.canEndFlight)
    local inDanger  = safe(tardis.isInDangerZone)
    local flightEvt = safe(tardis.getFlightEventActive)
    local evtCtrl   = safe(tardis.getFlightEventControl)
    local reqEvt    = safe(tardis.getRequiredFlightEvents) or 0
    local doneEvt   = safe(tardis.getRespondedFlightEvents) or 0
    local autoLand  = safe(tardis.getIsAutoLandSet)

    term.setBackgroundColor(UI.background)
    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext)
    term.write("Status  ")
    if inFlight then
        term.setTextColor(UI.primary)
        term.write("IN FLIGHT  ")
        term.setTextColor(UI.subtext)
        term.write(math.floor(pct * 100) .. "%")
    elseif canBegin then
        term.setTextColor(UI.success)
        term.write("READY")
    else
        term.setTextColor(UI.text)
        term.write("LANDED")
    end
    row = row + 1

    if inFlight then
        local barW   = w - 4
        local filled = math.floor(barW * pct)
        if filled > 0 then
            paintutils.drawFilledBox(3, row, 2 + filled, row, UI.primary)
        end
        if filled < barW then
            paintutils.drawFilledBox(3 + filled, row, 3 + barW - 1, row, UI.border)
        end
        row = row + 1
    end

    if inFlight and (inDanger or flightEvt) then
        paintutils.drawFilledBox(1, row, w, row, UI.error)
        term.setCursorPos(2, row)
        term.setBackgroundColor(UI.error)
        term.setTextColor(UI.background)
        if inDanger then
            term.write("!! DANGER ZONE - interact with controls now !!")
        elseif flightEvt and evtCtrl then
            term.write(">> Interact: " .. evtCtrl ..
                "  (" .. doneEvt .. "/" .. reqEvt .. ")")
        end
        row = row + 1
    end

    term.setBackgroundColor(UI.background)
    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext)
    term.write("Autopilot  ")
    term.setTextColor(autoLand and UI.success or UI.text)
    term.write(autoLand and "ON" or "OFF")
    term.setTextColor(UI.subtext)
    term.write("   Co-pilot  ")
    term.setTextColor(copilot and UI.success or UI.text)
    term.write(copilot and "ON" or "OFF")
end

-- ---- Confirm dialog ---------------------------------------------------------

local function confirmDialog(lines, yesLabel, noLabel)
    yesLabel = yesLabel or " Yes "
    noLabel  = noLabel  or " No  "

    term.setBackgroundColor(UI.background)
    for y = STATUS_ROW, h - 4 do
        term.setCursorPos(1, y)
        term.clearLine()
    end

    local midY   = math.floor((STATUS_ROW + h - 4) / 2)
    local startY = midY - math.floor(#lines / 2)

    for i, line in ipairs(lines) do
        term.setCursorPos(math.floor((w - #line) / 2), startY + i - 1)
        term.setTextColor(i == 1 and UI.error or UI.text)
        term.write(line)
    end

    local btnY = startY + #lines + 1
    local yesX = math.floor(w / 2) - #yesLabel - 1
    local noX  = math.floor(w / 2) + 2

    paintutils.drawFilledBox(yesX, btnY, yesX + #yesLabel - 1, btnY, UI.error)
    term.setCursorPos(yesX, btnY)
    term.setBackgroundColor(UI.error)
    term.setTextColor(UI.background)
    term.write(yesLabel)

    paintutils.drawFilledBox(noX, btnY, noX + #noLabel - 1, btnY, UI.primary)
    term.setCursorPos(noX, btnY)
    term.setBackgroundColor(UI.primary)
    term.setTextColor(UI.background)
    term.write(noLabel)

    while true do
        local e, p1, p2, p3 = os.pullEvent()
        if e == "mouse_click" or e == "monitor_touch" then
            local mx, my = p2, p3
            if my == btnY then
                if mx >= yesX and mx <= yesX + #yesLabel - 1 then return true end
                if mx >= noX  and mx <= noX  + #noLabel  - 1 then return false end
            end
        elseif e == "key" then
            if p1 == keys.enter or p1 == keys.y then return true end
            if p1 == keys.n or p1 == keys.backspace or p1 == keys.escape then return false end
        end
    end
end

-- ---- Buttons ----------------------------------------------------------------

local function drawButtons()
    btnDefs = {}
    local row = h - 2

    paintutils.drawFilledBox(1, row - 1, w, row - 1, UI.border)
    term.setBackgroundColor(UI.background)
    for y = row, h do
        term.setCursorPos(1, y)
        term.clearLine()
    end

    local inFlight = safe(tardis.isInFlight)
    local canBegin = safe(tardis.canBeginFlight)
    local canEnd   = safe(tardis.canEndFlight)
    local autoLand = safe(tardis.getIsAutoLandSet)

    local btns = {}

    table.insert(btns, {
        label  = " Set Target ",
        col    = UI.primary,
        action = function()
            local x = tonumber(fields.x)
            local y = tonumber(fields.y)
            local z = tonumber(fields.z)
            if not x or not y or not z then
                statusMsg = "X, Y, Z must be numbers."
                statusCol = UI.error
                return
            end
            if dimSelected then
                pcall(tardis.setTargetDimension, dimSelected)
            end
            if fields.facing ~= "" then
                local ok2 = pcall(tardis.setTargetDirection, fields.facing)
                if not ok2 then
                    statusMsg = "Invalid facing. Use north/south/east/west."
                    statusCol = UI.error
                    return
                end
            end
            pcall(tardis.setTargetPosition, x, y, z)
            statusMsg = "Target set."
            statusCol = UI.success
        end,
    })

    if not inFlight and canBegin then
        table.insert(btns, {
            label  = " Begin Flight ",
            col    = UI.success,
            action = function()
                local stab = safe(tardis.getIsAutoLandSet) or false
                pcall(tardis.beginFlight, stab)
                statusMsg = "Flight started."
                statusCol = UI.primary
            end,
        })
    elseif inFlight and canEnd then
        table.insert(btns, {
            label  = " End Flight ",
            col    = UI.error,
            action = function()
                pcall(tardis.endFlight)
                statusMsg = "Landing..."
                statusCol = UI.primary
            end,
        })
    end

    table.insert(btns, {
        label  = autoLand and " Autopilot ON " or " Autopilot OFF ",
        col    = autoLand and UI.success or UI.border,
        action = function()
            local cur = safe(tardis.getIsAutoLandSet) or false
            if not cur then
                -- Warn before enabling — autopilot skips the flight minigame
                local confirmed = confirmDialog({
                    "  Enable Autopilot?  ",
                    "",
                    "Autopilot stabilizes flight and skips",
                    "all mid-flight control interactions,",
                    "making travel nearly instant.",
                    "",
                    "This removes the flying minigame entirely.",
                    "Are you sure?",
                }, " Enable ", " Cancel ")
                if not confirmed then
                    redraw()
                    return
                end
            end
            pcall(tardis.setAutoLand, not cur)
            statusMsg = "Autopilot " .. (not cur and "enabled." or "disabled.")
            statusCol = UI.subtext
        end,
    })

    table.insert(btns, {
        label  = copilot and " Co-pilot ON " or " Co-pilot OFF ",
        col    = copilot and UI.success or UI.border,
        action = function()
            copilot = not copilot
            statusMsg = "Co-pilot " .. (copilot and "enabled." or "disabled.")
            statusCol = UI.subtext
        end,
    })

    table.insert(btns, {
        label  = " Back ",
        col    = UI.border,
        action = "back",
    })

    local x = 2
    for _, btn in ipairs(btns) do
        local x2 = x + #btn.label - 1
        paintutils.drawFilledBox(x, row, x2, row, btn.col)
        term.setCursorPos(x, row)
        term.setBackgroundColor(btn.col)
        term.setTextColor(btn.col == UI.border and UI.text or UI.fgDark)
        term.write(btn.label)
        table.insert(btnDefs, { x1=x, x2=x2, y=row, action=btn.action })
        x = x2 + 2
    end

    if statusMsg ~= "" then
        term.setCursorPos(2, h)
        term.setBackgroundColor(UI.background)
        term.setTextColor(statusCol or UI.subtext)
        term.clearLine()
        term.write(statusMsg)
    end
end

local function redraw()
    term.setBackgroundColor(UI.background)
    term.clear()
    drawHeader()
    drawCurrent()
    drawForm()
    drawFlightStatus()
    drawButtons()
end

-- ---- Co-pilot flash ---------------------------------------------------------

local function doCopilotFlash()
    for _ = 1, 3 do
        paintutils.drawFilledBox(1, 1, w, h, UI.error)
        sleep(0.1)
        redraw()
        sleep(0.15)
    end
end

-- ---- Entry ------------------------------------------------------------------

loadDimensions()
redraw()

local pollTimer    = os.startTimer(0.5)
local flashTimer   = nil
local lastEvtState = false
local running      = true

while running do
    local e, p1, p2, p3 = os.pullEvent()

    if e == "timer" then
        if p1 == pollTimer then
            drawFlightStatus()
            drawButtons()

            if copilot and tardisOk then
                local evtNow = safe(tardis.getFlightEventActive) or false
                local danger  = safe(tardis.isInDangerZone) or false
                if (evtNow or danger) and not lastEvtState then
                    flashTimer = os.startTimer(0)
                end
                lastEvtState = evtNow or danger
            end

            pollTimer = os.startTimer(0.5)
        elseif p1 == flashTimer then
            doCopilotFlash()
            flashTimer = nil
        end

    elseif e == "onTakeOff" or e == "onLand" or e == "onCrashed" then
        drawFlightStatus()
        drawButtons()

    elseif e == "char" then
        if not dimPickerOpen then
            local key = fieldOrder[activeField]
            fields[key] = fields[key] .. p1
            drawForm()
        end

    elseif e == "key" then
        if dimPickerOpen then
            if p1 == keys.up then
                if dimScroll > 0 then dimScroll = dimScroll - 1 end
                -- Move selection up
                local curIdx = 1
                for i, d in ipairs(dimensions) do if d == dimSelected then curIdx = i end end
                if curIdx > 1 then dimSelected = dimensions[curIdx - 1] end
                drawForm()
            elseif p1 == keys.down then
                local curIdx = 1
                for i, d in ipairs(dimensions) do if d == dimSelected then curIdx = i end end
                if curIdx < #dimensions then
                    dimSelected = dimensions[curIdx + 1]
                    if curIdx + 1 > dimScroll + DIM_PICKER_H then
                        dimScroll = dimScroll + 1
                    end
                end
                drawForm()
            elseif p1 == keys.enter then
                dimPickerOpen = false
                redraw()
            elseif p1 == keys.escape or p1 == keys.backspace then
                dimPickerOpen = false
                redraw()
            end
        else
            if p1 == keys.backspace then
                local key = fieldOrder[activeField]
                if #fields[key] > 0 then
                    fields[key] = fields[key]:sub(1, -2)
                    drawForm()
                else
                    running = false
                end
            elseif p1 == keys.tab or p1 == keys.down then
                activeField = activeField % #fieldOrder + 1
                drawForm()
            elseif p1 == keys.up then
                activeField = ((activeField - 2) % #fieldOrder) + 1
                drawForm()
            elseif p1 == keys.enter then
                if activeField < #fieldOrder then
                    activeField = activeField + 1
                    drawForm()
                end
            end
        end

    elseif e == "mouse_click" or e == "monitor_touch" then
        local mx, my = p2, p3

        -- Dimension picker list click
        if dimPickerOpen then
            if my >= DIM_PICKER_Y and my < DIM_PICKER_Y + DIM_PICKER_H then
                local idx = my - DIM_PICKER_Y + 1 + dimScroll
                if dimensions[idx] then
                    dimSelected = dimensions[idx]
                    dimPickerOpen = false
                    redraw()
                end
            elseif my ~= 11 then
                -- Click outside picker closes it
                dimPickerOpen = false
                redraw()
            end

        else
            -- Dimension field click (row 11)
            if my == 11 and mx >= 15 and mx <= w - 1 then
                dimPickerOpen = true
                dimScroll = 0
                -- Scroll to current selection
                for i, d in ipairs(dimensions) do
                    if d == dimSelected then
                        dimScroll = math.max(0, i - 1)
                        break
                    end
                end
                drawForm()

            -- Text field clicks
            else
                for i, key in ipairs(fieldOrder) do
                    local fy = 7 + (i - 1)
                    if my == fy and mx >= 15 and mx <= w - 2 then
                        activeField = i
                        drawForm()
                        break
                    end
                end
            end

            -- Button clicks
            for _, btn in ipairs(btnDefs) do
                if my == btn.y and mx >= btn.x1 and mx <= btn.x2 then
                    if btn.action == "back" then
                        running = false
                    else
                        btn.action()
                        drawFlightStatus()
                        drawButtons()
                    end
                    break
                end
            end
        end

    elseif e == "mouse_scroll" then
        if dimPickerOpen then
            if p1 == 1 and dimScroll + DIM_PICKER_H < #dimensions then
                dimScroll = dimScroll + 1; drawForm()
            elseif p1 == -1 and dimScroll > 0 then
                dimScroll = dimScroll - 1; drawForm()
            end
        end
    end
end

term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1, 1)
shell.run(".menu")
