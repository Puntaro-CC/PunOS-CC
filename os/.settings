-- PunOS Settings
-- Theme selection with live preview and correct palette per tile

os.pullEvent = os.pullEventRaw

local w, h = term.getSize()

local THEME_FILE  = "/.theme"
local THEME_ORDER = { "classic", "factory", "coral", "copper", "toyota", "tardis" }
local THEME_NAMES = {
    classic = "PunOS Classic",
    factory = "Factory",
    coral   = "Coral",
    copper  = "Copper",
    toyota  = "Toyota",
    tardis  = "TARDIS",
}

local allThemes = {
    classic = { primary=colors.orange,  secondary=colors.yellow,    background=colors.black, text=colors.white,     subtext=colors.lightGray, border=colors.gray      },
    factory = { primary=colors.cyan,    secondary=colors.lightBlue, background=colors.white, text=colors.black,     subtext=colors.gray,      border=colors.lightGray },
    coral   = { primary=colors.magenta, secondary=colors.pink,      background=colors.black, text=colors.white,     subtext=colors.pink,      border=colors.orange    },
    copper  = { primary=colors.orange,  secondary=colors.yellow,    background=colors.black, text=colors.yellow,    subtext=colors.lime,      border=colors.green     },
    toyota  = { primary=colors.orange,  secondary=colors.lightBlue, background=colors.black, text=colors.lightGray, subtext=colors.lightBlue, border=colors.gray      },
    tardis  = { primary=colors.cyan,    secondary=colors.lightBlue, background=colors.black, text=colors.white,     subtext=colors.blue,      border=colors.gray      },
}

-- Read current theme from file
local currentTheme = "classic"
if fs.exists(THEME_FILE) then
    local f = fs.open(THEME_FILE, "r")
    currentTheme = f.readAll():gsub("%s+", "")
    f.close()
end
if not allThemes[currentTheme] then currentTheme = "classic" end

-- Apply current theme palette and get UI colors
local UI = dofile("/os/loadTheme.lua")

local selectedTheme = currentTheme
local themeButtons  = {}
local applyBtn      = {}
local backBtn       = {}

-- ---- Palette helpers --------------------------------------------------------

-- Temporarily write a theme to file, apply its palette, call fn, then restore.
-- Used to draw each tile and preview with the correct palette active.
local function withPalette(key, fn)
    local f = fs.open(THEME_FILE, "w")
    f.write(key); f.close()
    dofile("/os/loadTheme.lua")
    fn()
    -- Restore active theme palette
    local f2 = fs.open(THEME_FILE, "w")
    f2.write(currentTheme); f2.close()
    dofile("/os/loadTheme.lua")
end

-- Apply palette for selected theme (for preview), then restore current
local function withSelectedPalette(fn)
    if selectedTheme == currentTheme then
        fn()
    else
        withPalette(selectedTheme, fn)
    end
end

-- Restore current theme palette and UI — call on any exit path
local function restoreCurrentPalette()
    local f = fs.open(THEME_FILE, "w")
    f.write(currentTheme); f.close()
    UI = dofile("/os/loadTheme.lua")
end

-- ---- Draw -------------------------------------------------------------------

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1)
    term.setTextColor(UI.primary)
    term.write("PunOS")
    term.setCursorPos(2, 2)
    term.setTextColor(UI.subtext)
    term.write("Settings    Theme")
    local info = "ID:" .. os.getComputerID()
    term.setCursorPos(w - #info - 1, 2)
    term.setTextColor(UI.subtext)
    term.write(info)
end

local function drawThemeGrid()
    themeButtons = {}

    local COLS   = 3
    local tileW  = math.floor((w - 2) / COLS)
    local tileH  = 5
    local startY = 4

    for i, key in ipairs(THEME_ORDER) do
        local col = (i - 1) % COLS
        local row = math.floor((i - 1) / COLS)
        local x1  = 2 + col * tileW
        local x2  = x1 + tileW - 1
        local y1  = startY + row * (tileH + 1)
        local y2  = y1 + tileH - 1

        -- Draw this tile with its own palette active so colors are correct
        withPalette(key, function()
            local t = allThemes[key]

            paintutils.drawFilledBox(x1, y1, x2, y2, t.border)
            paintutils.drawFilledBox(x1, y1, x2, y1, t.primary)

            term.setCursorPos(x1 + 1, y1 + 1)
            term.setBackgroundColor(t.border)
            term.setTextColor(t.primary)
            local name = THEME_NAMES[key]
            if #name > tileW - 2 then name = name:sub(1, tileW - 3) end
            term.write(name)

            term.setCursorPos(x1 + 1, y1 + 2)
            term.setTextColor(t.text)
            term.write("Text")

            term.setCursorPos(x1 + 1, y1 + 3)
            term.setTextColor(t.subtext)
            term.write("Sub")

            if key == selectedTheme then
                paintutils.drawBox(x1, y1, x2, y2, t.primary)
                term.setCursorPos(x1 + math.floor((tileW - 1) / 2), y2)
                term.setBackgroundColor(t.primary)
                term.setTextColor(t.border)
                term.write("*")
            end
        end)

        themeButtons[key] = {x1=x1, y1=y1, x2=x2, y2=y2}
    end
end

local function drawPreview()
    local preY = 17

    -- Clear preview area using current UI palette
    term.setBackgroundColor(UI.background)
    for y = preY, preY + 6 do
        term.setCursorPos(1, y)
        term.clearLine()
    end

    term.setCursorPos(2, preY)
    term.setTextColor(UI.subtext)
    term.write("Preview:")

    -- Draw the actual preview with selected theme's palette
    withSelectedPalette(function()
        local t = allThemes[selectedTheme]
        local px1, px2 = 2, w - 1

        paintutils.drawFilledBox(px1, preY + 1, px2, preY + 1, t.border)
        term.setCursorPos(px1 + 1, preY + 1)
        term.setTextColor(t.primary)
        term.write("PunOS  ")
        term.setTextColor(t.subtext)
        term.write("Sample Program")

        paintutils.drawFilledBox(px1, preY + 2, px2, preY + 2, t.primary)
        term.setCursorPos(px1 + 1, preY + 2)
        term.setTextColor(t.background ~= colors.black and colors.black or colors.white)
        term.write("> Selected Item")

        paintutils.drawFilledBox(px1, preY + 3, px2, preY + 3, t.background)
        term.setCursorPos(px1 + 1, preY + 3)
        term.setTextColor(t.text)
        term.write("  Normal Item")

        paintutils.drawFilledBox(px1, preY + 4, px2, preY + 4, t.border)
        term.setCursorPos(px1 + 1, preY + 4)
        term.setTextColor(t.subtext)
        term.write("Footer text here")
    end)

    -- Selected label drawn with current UI palette
    term.setCursorPos(2, preY + 6)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.subtext)
    term.write("Selected: ")
    term.setTextColor(allThemes[selectedTheme].primary)
    term.write(THEME_NAMES[selectedTheme])
    if selectedTheme == currentTheme then
        term.setTextColor(UI.success)
        term.write("  (active)")
    end
end

local function drawActions()
    local row = h - 1

    paintutils.drawFilledBox(1, row - 1, w, row - 1, UI.border)

    local applyLabel = " Apply Theme "
    local ax    = math.floor(w / 2) - #applyLabel - 1
    local isNew = selectedTheme ~= currentTheme
    paintutils.drawFilledBox(ax, row, ax + #applyLabel - 1, row,
        isNew and UI.primary or UI.border)
    term.setCursorPos(ax, row)
    term.setBackgroundColor(isNew and UI.primary or UI.border)
    term.setTextColor(isNew and UI.fgDark or UI.subtext)
    term.write(applyLabel)
    applyBtn = {x1=ax, y1=row, x2=ax+#applyLabel-1, y2=row}

    local backLabel = " Back "
    local bx = math.floor(w / 2) + 2
    paintutils.drawFilledBox(bx, row, bx + #backLabel - 1, row, UI.border)
    term.setCursorPos(bx, row)
    term.setBackgroundColor(UI.border)
    term.setTextColor(UI.text)
    term.write(backLabel)
    backBtn = {x1=bx, y1=row, x2=bx+#backLabel-1, y2=row}
end

local function redraw()
    term.setBackgroundColor(UI.background)
    term.clear()
    drawHeader()
    drawThemeGrid()
    drawPreview()
    drawActions()
end

local function applyTheme()
    -- Write new theme and fully apply it
    local f = fs.open(THEME_FILE, "w")
    f.write(selectedTheme); f.close()
    currentTheme = selectedTheme
    UI = dofile("/os/loadTheme.lua")

    term.setCursorPos(2, h)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.success)
    term.write("Saved! Restart programs for full effect.     ")
    sleep(2)
    redraw()
end

-- ---- Event loop -------------------------------------------------------------

redraw()

while true do
    local e, p1, p2, p3 = os.pullEvent()

    if e == "mouse_click" then
        local mx, my = p2, p3
        local tileClicked = false

        for key, r in pairs(themeButtons) do
            if mx >= r.x1 and mx <= r.x2 and my >= r.y1 and my <= r.y2 then
                selectedTheme = key
                drawThemeGrid(); drawPreview(); drawActions()
                tileClicked = true
                break
            end
        end

        if not tileClicked then
            if mx >= applyBtn.x1 and mx <= applyBtn.x2 and my == applyBtn.y1 then
                applyTheme()
            elseif mx >= backBtn.x1 and mx <= backBtn.x2 and my == backBtn.y1 then
                restoreCurrentPalette()
                break
            end
        end

    elseif e == "key" then
        local idx = 1
        for i, k in ipairs(THEME_ORDER) do if k == selectedTheme then idx = i end end

        if p1 == keys.left or p1 == keys.a then
            if idx > 1 then selectedTheme = THEME_ORDER[idx-1]; drawThemeGrid(); drawPreview(); drawActions() end
        elseif p1 == keys.right or p1 == keys.d then
            if idx < #THEME_ORDER then selectedTheme = THEME_ORDER[idx+1]; drawThemeGrid(); drawPreview(); drawActions() end
        elseif p1 == keys.up or p1 == keys.w then
            if idx > 3 then selectedTheme = THEME_ORDER[idx-3]; drawThemeGrid(); drawPreview(); drawActions() end
        elseif p1 == keys.down or p1 == keys.s then
            if idx+3 <= #THEME_ORDER then selectedTheme = THEME_ORDER[idx+3]; drawThemeGrid(); drawPreview(); drawActions() end
        elseif p1 == keys.enter then
            applyTheme()
        elseif p1 == keys.backspace then
            restoreCurrentPalette()
            break
        end
    end
end

term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1, 1)
shell.run(".menu")
