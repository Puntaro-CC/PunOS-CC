-- PunOS Updater
-- Incremental updates gated by version.json commits, rollback, kernel awareness

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

-- ---- Read installed kernel --------------------------------------------------

local LOCAL_KERNEL = "/.punos_kernel"
local kernel = "main"
if fs.exists(LOCAL_KERNEL) then
    local kf = fs.open(LOCAL_KERNEL, "r")
    kernel = kf.readAll():gsub("%s+", "")
    kf.close()
end

-- Validate current kernel against supported list, default to main if unknown
if kernel ~= "main" and kernel ~= "tardis" and kernel ~= "botto" and kernel ~= "bleeding" then
    kernel = "main"
end

-- ---- Constants & Repository Config -----------------------------------------

local REPO_RAW       = "https://raw.githubusercontent.com/Puntaro-CC/PunOS-CC/"
local API_BASE       = "https://api.github.com/repos/Puntaro-CC/PunOS-CC/"
local LOCAL_VER      = "/.punos_version"

-- List of all available kernels to display as tabs
local KERNELS = { "main", "tardis", "botto", "bleeding" }

-- ---- Global State Management -----------------------------------------------

local activeTab     = 1  -- Defaults to the first kernel tab ("main")
local selectedIdx   = nil
local scrollOff     = 0

-- Track selected entries and scrolls separately for each kernel tab
local kernelStates = {}
for i, kName in ipairs(KERNELS) do
    kernelStates[i] = { selectedIdx = 1, scrollOff = 0, entries = {}, filesOk = false, loading = true }
    -- Automatically set active tab to match the currently running kernel on startup
    if kName == kernel then
        activeTab = i
    end
end

local HIST_START    = 4
local HIST_VIS      = h - HIST_START - 1

-- ---- UI Utilities -----------------------------------------------------------

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Kernel Updates & History")
end

local function drawTabs()
    local bounds = {}
    local currentX = 2
    local actY = 3

    term.setCursorPos(1, actY)
    term.setBackgroundColor(UI.background)
    term.clearLine()

    for i, kName in ipairs(KERNELS) do
        local label = " " .. kName:upper() .. " "
        if i == activeTab then
            term.setBackgroundColor(UI.secondary)
            term.setTextColor(UI.text)
        else
            term.setBackgroundColor(UI.border)
            term.setTextColor(UI.subtext)
        end
        
        term.setCursorPos(currentX, actY)
        term.write(label)
        
        bounds[i] = { x1 = currentX, x2 = currentX + #label - 1 }
        currentX = currentX + #label + 1
    end
    
    -- Draw current local kernel status info indicator
    local statusText = "Kernel: " .. kernel:upper()
    term.setCursorPos(w - #statusText, actY)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.primary)
    term.write(statusText)
    
    return bounds
end

local function wrongKernelDialog(targetKernel)
    local dw, dh = 30, 6
    local dx = math.floor((w - dw) / 2) + 1
    local dy = math.floor((h - dh) / 2) + 1

    paintutils.drawFilledBox(dx, dy, dx + dw - 1, dy + dh - 1, UI.border)
    paintutils.drawFilledBox(dx + 1, dy + 1, dx + dw - 2, dy + dh - 2, UI.background)

    term.setTextColor(UI.error)
    local msg1 = "KERNEL MISMATCH"
    term.setCursorPos(dx + math.floor((dw - #msg1)/2), dy + 1)
    term.write(msg1)

    term.setTextColor(UI.text)
    local msg2 = "Your system is using " .. kernel:upper() .. "."
    local msg3 = "Cannot safe flash " .. targetKernel:upper() .. "."
    term.setCursorPos(dx + math.floor((dw - #msg2)/2), dy + 3)
    term.write(msg2)
    term.setCursorPos(dx + math.floor((dw - #msg3)/2), dy + 4)
    term.write(msg3)

    term.setTextColor(UI.subtext)
    local msg4 = "[Press any key]"
    term.setCursorPos(dx + math.floor((dw - #msg4)/2), dy + 5)
    term.write(msg4)

    os.pullEvent("key")
end

local function confirmRollback(entry, targetKernel)
    local dw, dh = 36, 7
    local dx = math.floor((w - dw) / 2) + 1
    local dy = math.floor((h - dh) / 2) + 1

    paintutils.drawFilledBox(dx, dy, dx + dw - 1, dy + dh - 1, UI.border)
    paintutils.drawFilledBox(dx + 1, dy + 1, dx + dw - 2, dy + dh - 2, UI.background)

    term.setTextColor(UI.primary)
    local title = "CONFIRM SYSTEM FLASH"
    term.setCursorPos(dx + math.floor((dw - #title)/2), dy + 1)
    term.write(title)

    term.setTextColor(UI.text)
    local m1 = "Flash " .. targetKernel:upper() .. " build?"
    local m2 = "Date: " .. entry.date:sub(1,10)
    term.setCursorPos(dx + math.floor((dw - #m1)/2), dy + 3)
    term.write(m1)
    term.setCursorPos(dx + math.floor((dw - #m2)/2), dy + 4)
    term.write(m2)

    term.setTextColor(UI.subtext)
    local m3 = "[Y] Confirm / [N] Cancel"
    term.setCursorPos(dx + math.floor((dw - #m3)/2), dy + 5)
    term.write(m3)

    while true do
        local _, key = os.pullEvent("key")
        if key == keys.y then return true
        elseif key == keys.n then return false end
    end
end

local function drawHistoryTab()
    term.setBackgroundColor(UI.background)
    for y = HIST_START, HIST_START + HIST_VIS do
        term.setCursorPos(1, y)
        term.clearLine()
    end

    local state = kernelStates[activeTab]
    local targetKernel = KERNELS[activeTab]

    if state.loading then
        term.setCursorPos(2, HIST_START)
        term.setTextColor(UI.subtext)
        term.write("Fetching target history from repository...")
        return
    end

    if not state.filesOk or #state.entries == 0 then
        term.setCursorPos(2, HIST_START)
        term.setTextColor(UI.error)
        term.write("Failed to connect or track remote manifest.")
        return
    end

    for i = 1 + state.scrollOff, math.min(#state.entries, HIST_VIS + state.scrollOff + 1) do
        local entry = state.entries[i]
        if entry then
            local y = HIST_START + (i - 1 - state.scrollOff)
            term.setCursorPos(2, y)

            if i == state.selectedIdx then
                term.setBackgroundColor(UI.secondary)
                term.setTextColor(UI.text)
            else
                term.setBackgroundColor(UI.background)
                term.setTextColor(UI.text)
            end

            local tag = entry.isCurrent and " [Current]" or ""
            local line = entry.date:sub(1,10) .. " - " .. entry.msg
            line = line .. string.rep(" ", w - #line - #tag - 2)
            term.write(line:sub(1, w - #tag - 2) .. tag)
        end
    end
    term.setBackgroundColor(UI.background)
end

-- ---- Networking / Data Acquisition ------------------------------------------

local function fetchKernelHistory(tabIndex)
    local state = kernelStates[tabIndex]
    local targetKernel = KERNELS[tabIndex]
    state.loading = true
    state.entries = {}
    
    local currentSHA = ""
    if targetKernel == kernel and fs.exists(LOCAL_VER) then
        local vf = fs.open(LOCAL_VER, "r")
        currentSHA = vf.readAll():gsub("%s+", "")
        vf.close()
    end

    local url = API_BASE .. "commits?path=version.json&per_page=20&sha=" .. targetKernel
    local res = http.get(url)
    if not res then
        state.filesOk = false
        state.loading = false
        return
    end

    local raw = res.readAll()
    res.close()

    local commits = textutils.unserialiseJSON(raw)
    if not commits or type(commits) ~= "table" then
        state.filesOk = false
        state.loading = false
        return
    end

    for _, c in ipairs(commits) do
        table.insert(state.entries, {
            sha       = c.sha,
            date      = c.commit.committer.date,
            msg       = c.commit.message:gsub("\n", " "),
            isCurrent = (c.sha == currentSHA)
        })
    end

    state.filesOk = true
    state.loading = false
end

local function doUpdate(targetSHA, isRollback, customRawPath)
    term.setBackgroundColor(colors.black)
    term.clear()
    term.setCursorPos(1, 1)

    local targetKernel = KERNELS[activeTab]
    print(isRollback and "Flashing Kernel Image..." or "Running Incremental Update...")
    print("Commit SHA: " .. targetSHA)

    local pathPrefix = customRawPath or (REPO_RAW .. targetKernel .. "/")
    local verUrl = pathPrefix .. "version.json"
    
    local vres = http.get(verUrl)
    if not vres then
        printError("Failed to fetch remote structural mapping layout.")
        sleep(2)
        return
    end
    local vraw = vres.readAll()
    vres.close()

    local manifest = textutils.unserialiseJSON(vraw)
    if not manifest or not manifest.files then
        printError("Malformed version configuration manifest.")
        sleep(2)
        return
    end

    -- Process downloads from structural block array
    for i, fileObj in ipairs(manifest.files) do
        print("Fetching [" .. i .. "/" .. #manifest.files .. "]: " .. fileObj.path)
        local fRes = http.get(pathPrefix .. fileObj.path)
        if fRes then
            local fData = fRes.readAll()
            fRes.close()
            local localPath = fs.combine("/", fileObj.path)
            local dir = fs.getDir(localPath)
            if not fs.exists(dir) then fs.makeDir(dir) end
            local f = fs.open(localPath, "w")
            f.write(fData)
            f.close()
        else
            printError("Aborted: Network block loss at " .. fileObj.path)
            sleep(2)
            return
        end
    end

    -- Write localized verification tokens onto disk configuration layers
    local vf = fs.open(LOCAL_VER, "w")
    vf.write(targetSHA)
    vf.close()

    local kf = fs.open(LOCAL_KERNEL, "w")
    kf.write(targetKernel)
    kf.close()

    print("\nUpdate completed successfully. Rebooting system context...")
    sleep(1.5)
    os.reboot()
end

-- ---- Main Logic Execution Loop ----------------------------------------------

term.setBackgroundColor(UI.background)
term.clear()
drawHeader()
local tabBounds = drawTabs()
drawHistoryTab()

-- Threaded history population wrapper across available target vectors
parallel.waitForAll(
    function() fetchKernelHistory(1) end,
    function() fetchKernelHistory(2) end,
    function() fetchKernelHistory(3) end,
    function() fetchKernelHistory(4) end
)

drawHistoryTab()

while true do
    local e, p1, p2, p3 = os.pullEvent()
    local state = kernelStates[activeTab]
    local targetKernel = KERNELS[activeTab]

    if e == "mouse_click" and p1 == 1 then
        local mx, my = p2, p3
        if my == 3 then
            for i, bound in ipairs(tabBounds) do
                if mx >= bound.x1 and mx <= bound.x2 and i ~= activeTab then
                    activeTab = i
                    tabBounds = drawTabs()
                    drawHistoryTab()
                    break
                end
            end
        elseif my >= HIST_START and my <= HIST_START + HIST_VIS and state.filesOk and not state.loading then
            local clickedIdx = my - HIST_START + 1 + state.scrollOff
            if clickedIdx <= #state.entries then
                state.selectedIdx = clickedIdx
                drawHistoryTab()
            end
        end

    elseif e == "mouse_scroll" then
        if state.filesOk and not state.loading then
            if p1 == 1 and state.scrollOff + HIST_VIS < #state.entries then
                state.scrollOff = state.scrollOff + 1
                drawHistoryTab()
            elseif p1 == -1 and state.scrollOff > 0 then
                state.scrollOff = state.scrollOff - 1
                drawHistoryTab()
            end
        end

    elseif e == "key" then
        if p1 == keys.q then
            break
        elseif state.filesOk and not state.loading then
            if p1 == keys.up then
                if state.selectedIdx > 1 then
                    state.selectedIdx = state.selectedIdx - 1
                    if state.selectedIdx - 1 < state.scrollOff then
                        state.scrollOff = state.selectedIdx - 1
                    end
                    drawHistoryTab()
                end
            elseif p1 == keys.down then
                if state.selectedIdx < #state.entries then
                    state.selectedIdx = state.selectedIdx + 1
                    if state.selectedIdx - 1 >= state.scrollOff + HIST_VIS then
                        state.scrollOff = state.selectedIdx - HIST_VIS
                    end
                    drawHistoryTab()
                end
            elseif p1 == keys.enter then
                -- Guard rails check: enforce flash confirmation checks across partitions
                if targetKernel ~= kernel then
                    wrongKernelDialog(targetKernel)
                    term.setBackgroundColor(UI.background)
                    term.clear()
                    drawHeader()
                    tabBounds = drawTabs()
                    drawHistoryTab()
                elseif state.selectedIdx and state.filesOk then
                    local entry = state.entries[state.selectedIdx]
                    if entry then
                        if confirmRollback(entry, targetKernel) then
                            doUpdate(entry.sha, true, REPO_RAW .. entry.sha .. "/")
                            return
                        end
                        term.setBackgroundColor(UI.background)
                        term.clear()
                        drawHeader()
                        tabBounds = drawTabs()
                        drawHistoryTab()
                    end
                end
            end
        end
    end
end

term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1, 1)
shell.run(".menu")
