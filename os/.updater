-- PunOS Updater

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local REPO_RAW     = "https://raw.githubusercontent.com/Puntaro-CC/PunOS-CC/"
local API_BASE     = "https://api.github.com/repos/Puntaro-CC/PunOS-CC/"
local LOCAL_SHA    = "/.punos_sha"
local LOCAL_VER    = "/.punos_version"
local LOCAL_KERNEL = "/.punos_kernel"

local kernel = "main"
if fs.exists(LOCAL_KERNEL) then
    local f = fs.open(LOCAL_KERNEL, "r")
    kernel = f.readAll():gsub("%s+", "")
    f.close()
end

local localSHA = ""
if fs.exists(LOCAL_SHA) then
    local f = fs.open(LOCAL_SHA, "r")
    localSHA = f.readAll():gsub("%s+", "")
    f.close()
end

local localVer = "?"
if fs.exists(LOCAL_VER) then
    local f = fs.open(LOCAL_VER, "r")
    localVer = f.readAll():gsub("%s+", "")
    f.close()
end

local KERNELS = { "main", "tardis", "botto", "bleeding" }
local activeTab = 1
for i, k in ipairs(KERNELS) do
    if k == kernel then activeTab = i end
end

local HIST_START = 4
local HIST_END   = h - 2
local HIST_VIS   = HIST_END - HIST_START + 1

local states = {}
for i = 1, #KERNELS do
    states[i] = { entries = {}, loading = true, error = false, sel = 1, scroll = 0 }
end

-- ---- Draw ----

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext); term.write("Updater")
    local info = "v" .. localVer .. "  kernel:" .. kernel
    term.setCursorPos(w - #info - 1, 2); term.setTextColor(UI.subtext); term.write(info)
end

local tabBounds = {}
local function drawTabs()
    tabBounds = {}
    paintutils.drawFilledBox(1, 3, w, 3, UI.border)
    local x = 2
    for i, k in ipairs(KERNELS) do
        local lbl = " " .. k:upper() .. " "
        if i == activeTab then
            paintutils.drawFilledBox(x, 3, x + #lbl - 1, 3, UI.primary)
            term.setCursorPos(x, 3); term.setTextColor(UI.background); term.write(lbl)
        else
            term.setBackgroundColor(UI.border)
            term.setCursorPos(x, 3); term.setTextColor(UI.subtext); term.write(lbl)
        end
        tabBounds[i] = { x1 = x, x2 = x + #lbl - 1 }
        x = x + #lbl + 1
    end
end

local function drawList()
    term.setBackgroundColor(UI.background)
    for y = HIST_START, HIST_END do
        term.setCursorPos(1, y); term.clearLine()
    end

    local s = states[activeTab]

    if s.loading then
        term.setCursorPos(2, HIST_START); term.setTextColor(UI.subtext)
        term.write("Fetching history...")
        return
    end
    if s.error then
        term.setCursorPos(2, HIST_START); term.setTextColor(UI.error)
        term.write("Network error — check HTTP is enabled.")
        return
    end
    if #s.entries == 0 then
        term.setCursorPos(2, HIST_START); term.setTextColor(UI.subtext)
        term.write("No commits found.")
        return
    end

    for i = 1 + s.scroll, math.min(#s.entries, HIST_VIS + s.scroll) do
        local entry = s.entries[i]
        local y = HIST_START + (i - 1 - s.scroll)
        term.setCursorPos(1, y)
        if i == s.sel then
            paintutils.drawFilledBox(1, y, w, y, UI.primary)
            term.setCursorPos(2, y); term.setTextColor(UI.background)
        else
            term.setBackgroundColor(UI.background)
            term.setTextColor(entry.isCurrent and UI.success or UI.text)
        end
        local tag = entry.isCurrent and " [installed]" or ""
        local line = entry.date:sub(1, 10) .. "  " .. entry.msg
        if #line + #tag > w - 3 then line = line:sub(1, w - #tag - 6) .. "..." end
        term.setCursorPos(2, y); term.write(line .. tag)
    end
    term.setBackgroundColor(UI.background)
end

local function drawFooter()
    paintutils.drawFilledBox(1, h - 1, w, h - 1, UI.border)
    term.setCursorPos(2, h - 1); term.setTextColor(UI.subtext)
    term.write("Up/Down: select  Enter/click: install  Backspace: back")

    paintutils.drawFilledBox(1, h, w, h, UI.border)
    term.setCursorPos(2, h); term.setTextColor(UI.subtext)
    term.write("Kernel: " .. kernel:upper())

    local installLbl = " Install "
    local ix = w - #installLbl
    paintutils.drawFilledBox(ix, h, w, h, UI.primary)
    term.setCursorPos(ix, h); term.setTextColor(UI.background); term.write(installLbl)
end

local function redraw()
    term.setBackgroundColor(UI.background); term.clear()
    drawHeader(); drawTabs(); drawList(); drawFooter()
end

-- ---- Dialogs ----

local function wrongKernelDialog(tk)
    local msg = "Cannot install " .. tk:upper() .. " while running " .. kernel:upper()
    local bx = math.floor((w - #msg - 4) / 2)
    local by = math.floor(h / 2) - 1
    paintutils.drawFilledBox(bx, by, bx + #msg + 3, by + 2, UI.border)
    paintutils.drawFilledBox(bx + 1, by + 1, bx + #msg + 2, by + 1, UI.background)
    term.setCursorPos(bx + 2, by + 1); term.setTextColor(UI.error); term.write(msg)
    os.pullEvent("key")
end

local function confirmInstall(entry, tk)
    local lines = {
        "Install " .. tk:upper() .. " commit?",
        entry.date:sub(1, 10) .. ": " .. entry.msg:sub(1, w - 8),
        "",
        "Y = confirm   N = cancel",
    }
    local bw = w - 8
    local bx = 4
    local by = math.floor(h / 2) - 3
    paintutils.drawFilledBox(bx, by, bx + bw, by + #lines + 1, UI.border)
    paintutils.drawFilledBox(bx + 1, by + 1, bx + bw - 1, by + #lines, UI.background)
    for i, l in ipairs(lines) do
        term.setCursorPos(bx + 2, by + i)
        term.setTextColor(i == 4 and UI.subtext or UI.text)
        term.write(l)
    end
    while true do
        local _, k = os.pullEvent("key")
        if k == keys.y then return true
        elseif k == keys.n or k == keys.backspace then return false end
    end
end

-- ---- Networking ----

local function fetchKernelHistory(idx)
    local s  = states[idx]
    local tk = KERNELS[idx]
    s.loading = true; s.entries = {}

    local url = API_BASE .. "commits?path=version.json&per_page=20&sha=" .. tk
    local res = http.get(url)
    if not res then s.error = true; s.loading = false; return end

    local body = res.readAll(); res.close()
    local ok, commits = pcall(textutils.unserialiseJSON, body)
    if not ok or type(commits) ~= "table" then
        s.error = true; s.loading = false; return
    end

    for _, c in ipairs(commits) do
        if type(c) == "table" and c.sha and c.commit then
            local date = ""
            if c.commit.committer then date = c.commit.committer.date or ""
            elseif c.commit.author then date = c.commit.author.date or "" end
            local msg = (c.commit.message or ""):match("^([^\n]+)") or ""
            table.insert(s.entries, {
                sha       = c.sha,
                date      = date,
                msg       = msg,
                isCurrent = (c.sha == localSHA),
            })
        end
    end

    s.loading = false
end

local function doUpdate(entry, targetKernel)
    term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
    term.setTextColor(UI.primary)
    print("Installing " .. targetKernel .. " @ " .. entry.sha:sub(1, 8) .. "...")
    term.setTextColor(UI.subtext)
    print("Fetching file list...")

    local rawBase = REPO_RAW .. entry.sha .. "/"

    local res = http.get(rawBase .. "files.json")
    if not res then
        term.setTextColor(UI.error); print("Failed to fetch files.json"); sleep(2); return
    end
    local filesBody = res.readAll(); res.close()

    -- Parse key-value format: "repoPath": "localPath"
    local files = {}
    for repoPath, localPath in filesBody:gmatch('"([^"]+)"%s*:%s*"([^"]+)"') do
        if repoPath ~= "files" then
            table.insert(files, { repoPath, localPath })
        end
    end

    if #files == 0 then
        term.setTextColor(UI.error); print("files.json empty or malformed"); sleep(2); return
    end

    local barW = w - 4; local barX = 3; local barY = 5
    paintutils.drawFilledBox(barX, barY, barX + barW - 1, barY, UI.border)

    for i, pair in ipairs(files) do
        local repoPath, localPath = pair[1], pair[2]

        term.setCursorPos(2, 7); term.setBackgroundColor(colors.black)
        term.setTextColor(UI.subtext); term.clearLine(); term.write(repoPath)

        local isBin = localPath:sub(-6) == ".dfpwm"
        local fRes = http.get(rawBase .. repoPath, nil, isBin)
        if fRes then
            local data = fRes.readAll(); fRes.close()
            local dir = fs.getDir(localPath)
            if dir ~= "" and not fs.exists(dir) then fs.makeDir(dir) end
            local f = fs.open(localPath, isBin and "wb" or "w")
            if f then f.write(data); f.close() end
        end

        local filled = math.floor(barW * i / #files)
        if filled > 0 then
            paintutils.drawFilledBox(barX, barY, barX + filled - 1, barY, UI.primary)
        end
        local pct = math.floor(100 * i / #files) .. "%"
        term.setCursorPos(math.floor((w - #pct) / 2), barY - 1)
        term.setBackgroundColor(colors.black); term.setTextColor(UI.primary); term.write(pct)
    end

    -- Fetch version string from version.json
    local vRes = http.get(rawBase .. "version.json")
    local vStr = "?"
    if vRes then
        local vBody = vRes.readAll(); vRes.close()
        vStr = vBody:match('"version"%s*:%s*"([^"]*)"') or "?"
    end

    local function writeFile(path, content)
        local f = fs.open(path, "w"); f.write(content); f.close()
    end
    writeFile(LOCAL_SHA, entry.sha)
    writeFile(LOCAL_VER, vStr)
    writeFile(LOCAL_KERNEL, targetKernel)

    term.setCursorPos(2, 9); term.setTextColor(UI.success); term.write("Done! v" .. vStr)
    for i = 3, 1, -1 do
        term.setCursorPos(2, h); term.setBackgroundColor(colors.black); term.clearLine()
        term.setTextColor(UI.subtext); term.write("Rebooting in " .. i .. "...")
        sleep(1)
    end
    os.reboot()
end

-- ---- Main ----

term.setBackgroundColor(UI.background); term.clear()
drawHeader(); drawTabs(); drawList(); drawFooter()

-- Fetch all kernel histories in parallel
parallel.waitForAll(
    function() fetchKernelHistory(1) end,
    function() fetchKernelHistory(2) end,
    function() fetchKernelHistory(3) end,
    function() fetchKernelHistory(4) end
)

redraw()

while true do
    local e, p1, p2, p3 = os.pullEvent()
    local s  = states[activeTab]
    local tk = KERNELS[activeTab]

    if e == "key" then
        if p1 == keys.backspace then
            break
        elseif not s.loading and not s.error then
            if p1 == keys.up and s.sel > 1 then
                s.sel = s.sel - 1
                if s.sel - 1 < s.scroll then s.scroll = s.sel - 1 end
                drawList()
            elseif p1 == keys.down and s.sel < #s.entries then
                s.sel = s.sel + 1
                if s.sel - 1 >= s.scroll + HIST_VIS then s.scroll = s.sel - HIST_VIS end
                drawList()
            elseif p1 == keys.enter and #s.entries > 0 then
                local entry = s.entries[s.sel]
                if tk ~= kernel then
                    wrongKernelDialog(tk); redraw()
                elseif entry then
                    if confirmInstall(entry, tk) then doUpdate(entry, tk) end
                    redraw()
                end
            end
        end

    elseif e == "mouse_scroll" then
        if not s.loading and not s.error then
            if p1 == 1 and s.scroll + HIST_VIS < #s.entries then
                s.scroll = s.scroll + 1; drawList()
            elseif p1 == -1 and s.scroll > 0 then
                s.scroll = s.scroll - 1; drawList()
            end
        end

    elseif e == "mouse_click" then
        local mx, my = p2, p3
        if my == 3 then
            for i, b in ipairs(tabBounds) do
                if mx >= b.x1 and mx <= b.x2 and i ~= activeTab then
                    activeTab = i; drawTabs(); drawList(); break
                end
            end
        elseif my >= HIST_START and my <= HIST_END and not s.loading and not s.error then
            local idx = my - HIST_START + 1 + s.scroll
            if idx >= 1 and idx <= #s.entries then
                s.sel = idx; drawList()
            end
        elseif my == h then
            local installLbl = " Install "
            local ix = w - #installLbl
            if mx >= ix and not s.loading and not s.error and #s.entries > 0 then
                local entry = s.entries[s.sel]
                if tk ~= kernel then
                    wrongKernelDialog(tk); redraw()
                elseif entry then
                    if confirmInstall(entry, tk) then doUpdate(entry, tk) end
                    redraw()
                end
            end
        end
    end
end

term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
shell.run(".menu")
