os.pullEvent = os.pullEventRaw

local w, h = term.getSize()
local UI = dofile("/os/loadTheme.lua")
local CommonUI = dofile("/os/CommonUI.lua")
local ui = CommonUI.New(term)

-- Page 1: main programs (no Back)
local page1 = {
    {name = "PublicChat",   icon = "##", desc = "No-history chat"},
    {name = "SecureChat",   icon = "@#", desc = "Encrypted chat"},
    {name = "Tetris",       icon = "[]", desc = "Classic game"},
    {name = "Paint",        icon = "::", desc = "Image editor"},
    {name = "Music",        icon = "~)", desc = "Stream music"},
    {name = "Audio Player", icon = ">>", desc = "Play local audio"},
    {name = "File Share",   icon = "<>", desc = "Network files"},
    {name = "Net Scanner",  icon = "@@", desc = "Scan network"},
    {name = "File Manager", icon = "FM", desc = "Rename/delete files"},
    {name = "Calculator",   icon = "+-", desc = "Calc + calculus"},
    {name = "CCDoom",       icon = ">!", desc = "3D shooter"},
    {name = "Disk Browser", icon = "[]", desc = "Browse disk drives"},
    {name = "Settings",     icon = "* ", desc = "Themes & config"},
    {name = "Updater",      icon = "^^", desc = "Check for updates"},
}

-- Page 2: extra programs + Back
local page2 = {
    {name = "Piano Studio", icon = "()", desc = "Play + export DFPWM"},
    {name = "Back",         icon = "<<", desc = "Return to menu"},
}

local pages = {page1, page2}

local cols      = 2
local boxWidth  = math.floor((w - 4) / cols) - 1
local boxHeight = 2
local startY    = 4
local startX    = 2

-- ================================================================
-- CommonUI component -- owns page/selection state, Fetch() builds
-- the whole frame, OnEvent() handles key + mouse_click.
-- ================================================================
local ProgramsList = CommonUI.EmptyControl()
ProgramsList.PosX, ProgramsList.PosY = 1, 1
ProgramsList.SizeX, ProgramsList.SizeY = w, h
ProgramsList.currentPage = 1
ProgramsList.nOption = 1
ProgramsList.buttonRegions = {}
ProgramsList.Chosen = nil

local function getPage(self)
    return pages[self.currentPage]
end

function ProgramsList:Fetch()
    local px = {}
    local function set(x, y, bg, fg, ch)
        if x < 1 or x > w or y < 1 or y > h then return end
        px[x .. ";" .. y] = CommonUI.MakePixel(bg, fg, ch)
    end
    local function fillRow(y, x1, x2, bg, fg)
        for x = x1, x2 do set(x, y, bg, fg, " ") end
    end
    local function text(x, y, s, bg, fg)
        for i = 1, #s do set(x + i - 1, y, bg, fg, s:sub(i, i)) end
    end

    for y = 1, h do fillRow(y, 1, w, UI.background, UI.text) end

    -- Header
    fillRow(1, 1, w, UI.border, UI.text)
    fillRow(2, 1, w, UI.border, UI.text)
    text(2, 1, "PunOS", UI.border, UI.primary)
    text(2, 2, "Programs", UI.border, UI.subtext)

    -- Grid
    local programs = getPage(self)
    self.buttonRegions = {}

    for i, program in ipairs(programs) do
        local col = (i - 1) % cols
        local row = math.floor((i - 1) / cols)
        local x = startX + col * (boxWidth + 2)
        local y = startY + row * boxHeight

        if y + boxHeight <= h - 1 then
            self.buttonRegions[i] = {x1 = x, y1 = y, x2 = x + boxWidth - 1, y2 = y + boxHeight - 1}

            local bg, fg
            if i == self.nOption then bg, fg = UI.primary, UI.background
            else bg, fg = UI.border, UI.text end

            for yy = y, y + boxHeight - 1 do fillRow(yy, x, x + boxWidth - 1, bg, fg) end
            text(x + 1, y, program.icon .. " " .. program.name, bg, fg)

            local descFg = (i == self.nOption) and UI.background or UI.subtext
            local desc = program.desc
            if #desc > boxWidth - 2 then desc = desc:sub(1, boxWidth - 5) .. "..." end
            text(x + 1, y + 1, desc, bg, descFg)
        end
    end

    -- Footer: hints + page dots
    fillRow(h, 1, w, UI.background, UI.text)
    local pageInfo = "WASD/Click: Select  Enter: Open  "
    if self.currentPage < #pages then
        pageInfo = pageInfo .. "Tab: Next page >"
    else
        pageInfo = pageInfo .. "Tab: < Prev page"
    end
    text(2, h, pageInfo, UI.background, UI.subtext)

    local dots = ""
    for i = 1, #pages do
        dots = dots .. (i == self.currentPage and "* " or ". ")
    end
    text(w - #dots, h, dots, UI.background, UI.primary)

    return px
end

function ProgramsList:OnEvent(event, p1, p2, p3)
    local programs = getPage(self)

    if event == "key" then
        if p1 == keys.w or p1 == keys.up then
            if self.nOption > 2 then self.nOption = self.nOption - 2
            elseif self.nOption == 2 then self.nOption = 1 end
            ui:DrawComponent(self.__ID__)
        elseif p1 == keys.s or p1 == keys.down then
            if self.nOption <= #programs - 2 then
                self.nOption = self.nOption + 2
                if self.nOption > #programs then self.nOption = #programs end
            elseif self.nOption == #programs - 1 then
                self.nOption = #programs
            end
            ui:DrawComponent(self.__ID__)
        elseif p1 == keys.a or p1 == keys.left then
            if self.nOption > 1 then self.nOption = self.nOption - 1; ui:DrawComponent(self.__ID__) end
        elseif p1 == keys.d or p1 == keys.right then
            if self.nOption < #programs then self.nOption = self.nOption + 1; ui:DrawComponent(self.__ID__) end
        elseif p1 == keys.tab then
            self.currentPage = self.currentPage % #pages + 1
            self.nOption = 1
            ui:DrawComponent(self.__ID__)
        elseif p1 == keys.backspace then
            self.Chosen = "__EXIT__"
        elseif p1 == keys.enter then
            self.Chosen = programs[self.nOption] and programs[self.nOption].name
        end

    elseif event == "mouse_click" then
        local mx, my = p2, p3
        for i, r in ipairs(self.buttonRegions) do
            if mx >= r.x1 and mx <= r.x2 and my >= r.y1 and my <= r.y2 then
                self.nOption = i
                ui:DrawComponent(self.__ID__)
                sleep(0.08)
                self.Chosen = programs[i].name
                break
            end
        end
    end
end

-- ================================================================
-- Run
-- ================================================================
local progId = ui:AddComponent(ProgramsList)
ui:FocusComponent(progId)
ui:DrawComponent(progId)

while not ProgramsList.Chosen do
    local event, p1, p2, p3 = os.pullEvent()
    ProgramsList:OnEvent(event, p1, p2, p3)
end

term.setBackgroundColor(colors.black)
term.clear()

local name = ProgramsList.Chosen

if     name == "__EXIT__"     then shell.run(".menu")
elseif name == "PublicChat"   then shell.run("/publicChat.lua", "join")
elseif name == "SecureChat"   then shell.run("os/.ChatApp")
elseif name == "Tetris"       then shell.run("os/.tetris")
elseif name == "Paint"        then shell.run("os/.choosePaint")
elseif name == "Music"        then shell.run("os/.music")
elseif name == "Audio Player" then shell.run("os/.audioPlayer")
elseif name == "File Share"   then shell.run("os/.fileShare")
elseif name == "Net Scanner"  then shell.run("os/.netScan")
elseif name == "File Manager" then shell.run("os/.fileManager")
elseif name == "Calculator"   then shell.run("os/.calculator")
elseif name == "CCDoom"       then shell.run("os/.doom")
elseif name == "Disk Browser" then shell.run("os/.diskBrowser")
elseif name == "Settings"     then shell.run("os/.settings")
elseif name == "Updater"      then shell.run("os/.updater")
elseif name == "Piano Studio" then shell.run("os/.piano")
elseif name == "Back"         then shell.run(".menu")
end
