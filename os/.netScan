-- PunOS Network Scanner

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local modem = peripheral.find("modem")
if not modem then
    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    term.setCursorPos(2, 5); term.setTextColor(UI.error);    term.write("No modem found.")
    term.setCursorPos(2, 7); term.setTextColor(UI.subtext);  term.write("Press any key.")
    os.pullEvent("key")
    shell.run("os/.programs")
    return
end

rednet.open(peripheral.getName(modem))

local results     = {}
local scanning    = false
local selectedIdx = 1
local scrollOff   = 0

local LIST_START = 4
local listHeight = h - LIST_START - 2

local scanBtn = { x1 = 2,     x2 = 10, y = h, label = "[ Scan ]" }
local backBtn = { x1 = w - 8, x2 = w,  y = h, label = "[ Back ]" }

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    local info = "ID:" .. os.getComputerID()
    term.setCursorPos(w - #info - 1, 2); term.write(info)
end

local function drawFooter()
    paintutils.drawFilledBox(1, h, w, h, UI.border)
    term.setCursorPos(scanBtn.x1, h)
    term.setTextColor(scanning and UI.subtext or UI.primary)
    term.write(scanBtn.label)
    term.setCursorPos(backBtn.x1, h)
    term.setTextColor(UI.error)
    term.write(backBtn.label)
end

local function drawList()
    term.setBackgroundColor(UI.background)
    for y = LIST_START, LIST_START + listHeight do
        term.setCursorPos(1, y); term.clearLine()
    end

    if #results == 0 then
        term.setCursorPos(2, LIST_START); term.setTextColor(UI.subtext)
        term.write(scanning and "Scanning network..." or "No active servers found.")
        return
    end

    for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
        local r = results[i]
        if r then
            local y = LIST_START + (i - 1 - scrollOff)
            if i == selectedIdx then
                paintutils.drawFilledBox(1, y, w, y, UI.primary)
                term.setCursorPos(2, y); term.setTextColor(UI.background)
            else
                term.setCursorPos(2, y); term.setTextColor(UI.text)
            end
            local line = "ID:" .. tostring(r.id) .. "  " .. r.service .. " - " .. r.hostname
            if #line > w - 2 then line = line:sub(1, w - 2) end
            term.write(line)
        end
    end
    term.setBackgroundColor(UI.background)
end

local function drawActions()
    local actY = h - 1
    term.setCursorPos(1, actY); term.setBackgroundColor(UI.background); term.clearLine()
    if #results > 0 and results[selectedIdx] then
        term.setCursorPos(2, actY); term.setTextColor(UI.primary)
        term.write("Enter: connect to selected server")
    end
end

-- Raw lookup: broadcasts on CC's internal CHANNEL_LOOKUP (65534) and collects
-- hostname info from the DNS responses that rednet servers send back.
local function rawLookup(protocol)
    local myID = os.getComputerID()

    -- Broadcast the lookup request using rednet so it gets properly wrapped.
    -- rednet automatically sets the reply channel to our computer ID.
    rednet.broadcast({
        sType     = "lookup",
        sProtocol = protocol,
        sHostname = nil,
    }, "dns")

    local found = {}
    local seen  = {}
    local timer = os.startTimer(2)

    while true do
        local ev, p1, p2, p3, p4 = os.pullEvent()

        if ev == "timer" and p1 == timer then
            break

        elseif ev == "rednet_message" then
            -- CC converts some modem messages to rednet_message events.
            -- Lookup responses arrive with protocol "dns".
            local senderID, msg, proto = p1, p2, p3
            if proto == "dns" and type(msg) == "table"
            and msg.sType == "lookup response" and msg.sProtocol == protocol
            and senderID ~= myID and not seen[senderID] then
                seen[senderID] = true
                table.insert(found, { id = senderID, hostname = msg.sHostname or tostring(senderID) })
            end

        elseif ev == "modem_message" then
            -- Fallback: intercept raw modem message in case rednet didn't wrap it.
            -- p1=side, p2=channel, p3=replyChannel, p4=rawMessage
            local channel, replyID, raw = p2, p3, p4
            if channel == myID and replyID ~= myID and type(raw) == "table" then
                -- Unwrap rednet envelope if present
                local msg = (type(raw.message) == "table") and raw.message or raw
                if msg.sType == "lookup response" and msg.sProtocol == protocol
                and not seen[replyID] then
                    seen[replyID] = true
                    table.insert(found, { id = replyID, hostname = msg.sHostname or tostring(replyID) })
                end
            end
        end
    end

    return found
end

local function doScan()
    scanning = true; results = {}; selectedIdx = 1; scrollOff = 0
    drawList(); drawActions()

    local seen = {}
    local protocols = {
        { proto = "nfp_share", label = "File Share", strip = nil       },
        { proto = "chat",      label = "Chat",       strip = "chat_"   },
    }

    for _, entry in ipairs(protocols) do
        local found = rawLookup(entry.proto)
        for _, r in ipairs(found) do
            if not seen[r.id] then
                seen[r.id] = true
                local hostname = r.hostname
                -- Strip known prefixes (e.g. "chat_general" -> "general")
                if entry.strip and hostname:sub(1, #entry.strip) == entry.strip then
                    hostname = hostname:sub(#entry.strip + 1)
                end
                table.insert(results, {
                    id       = r.id,
                    hostname = hostname,
                    service  = entry.label,
                    proto    = entry.proto,
                })
            end
        end
    end

    scanning = false; drawList(); drawActions()
end

local function fileSharePrompt()
    term.setBackgroundColor(UI.background); term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("File Share")

    local opts = {
        { label = "Upload",   desc = "Send a file to the server",  key = "upload"   },
        { label = "Download", desc = "Get a file from the server", key = "download" },
        { label = "Back",     desc = "Return to scanner",          key = "back"     },
    }
    local sel  = 1
    local btnW = 24
    local btnX = math.floor((w - btnW) / 2)
    local btns = {}

    local function drawPrompt()
        btns = {}
        for i, opt in ipairs(opts) do
            local y = 5 + (i - 1) * 3
            if i == sel then
                paintutils.drawFilledBox(btnX, y, btnX + btnW - 1, y + 1, UI.primary)
                term.setTextColor(UI.background)
            else
                paintutils.drawFilledBox(btnX, y, btnX + btnW - 1, y + 1, UI.border)
                term.setTextColor(UI.text)
            end
            term.setCursorPos(btnX + 1, y);     term.write(opt.label)
            term.setTextColor(i == sel and UI.background or UI.subtext)
            term.setCursorPos(btnX + 1, y + 1); term.write(opt.desc)
            btns[i] = { x1 = btnX, y1 = y, x2 = btnX + btnW - 1, y2 = y + 1 }
        end
    end

    drawPrompt()

    while true do
        local e, p1, p2, p3 = os.pullEvent()
        if e == "key" then
            if p1 == keys.up   and sel > 1          then sel = sel - 1; drawPrompt()
            elseif p1 == keys.down and sel < #opts  then sel = sel + 1; drawPrompt()
            elseif p1 == keys.enter                 then return opts[sel].key
            elseif p1 == keys.backspace             then return "back" end
        elseif e == "mouse_click" then
            local mx, my = p2, p3
            for i, b in ipairs(btns) do
                if mx >= b.x1 and mx <= b.x2 and my >= b.y1 and my <= b.y2 then
                    if sel == i then return opts[i].key
                    else sel = i; drawPrompt() end
                    break
                end
            end
        end
    end
end

