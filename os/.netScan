-- PunOS Network Scanner

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local modem = peripheral.find("modem")
if not modem then
    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    term.setCursorPos(2, 5); term.setTextColor(UI.error);    term.write("No modem found.")
    term.setCursorPos(2, 7); term.setTextColor(UI.subtext);  term.write("Press any key.")
    os.pullEvent("key")
    shell.run("os/.programs")
    return
end

rednet.open(peripheral.getName(modem))

-- rednet.lookup returns all hosts on a protocol as a table when no name given,
-- but CC's implementation actually only returns one ID. We work around this by
-- looking up known name patterns instead, since servers register with
-- "chat_<name>" and "fileshare_<name>" as their hostname on the punos protocol.
-- We query the raw protocol and collect via broadcast instead.

local SCAN_PROTOCOL = "punos_scan"
local SCAN_TIMEOUT  = 2

local results     = {}
local scanning    = false
local selectedIdx = 1
local scrollOff   = 0

local LIST_START = 5
local LIST_END   = h - 3
local listHeight = LIST_END - LIST_START + 1
local scanBtn    = {}
local backBtn    = {}

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    local info = "ID:" .. os.getComputerID()
    term.setCursorPos(w - #info - 1, 2); term.write(info)
end

local function drawStatus(msg, col)
    term.setCursorPos(1, 4)
    term.setBackgroundColor(UI.background)
    term.clearLine()
    term.setCursorPos(2, 4)
    term.setTextColor(col or UI.subtext)
    term.write(msg)
end

local function drawList()
    for y = LIST_START, LIST_END do
        term.setCursorPos(1, y)
        term.setBackgroundColor(UI.background)
        term.clearLine()
    end

    if #results == 0 then
        term.setCursorPos(2, LIST_START + 1)
        term.setTextColor(UI.subtext)
        term.write("No servers found. Press Scan.")
        return
    end

    for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff) do
        local y = LIST_START + (i - 1 - scrollOff)
        local r = results[i]

        if i == selectedIdx then
            paintutils.drawFilledBox(1, y, w, y, UI.primary)
            term.setTextColor(UI.background)
        else
            term.setTextColor(UI.text)
        end

        term.setCursorPos(2, y)
        -- Format: "ID:5  chat_general  [ComputerLabel]"
        local label = r.label ~= "" and ("  [" .. r.label .. "]") or ""
        local line  = "ID:" .. r.id .. "  " .. r.service .. label
        if #line > w - 2 then line = line:sub(1, w - 5) .. "..." end
        term.write(line)
    end

    if scrollOff > 0 then
        term.setCursorPos(w - 5, LIST_START)
        term.setBackgroundColor(UI.background); term.setTextColor(UI.subtext)
        term.write("[^ up]")
    end
    if scrollOff + listHeight < #results then
        term.setCursorPos(w - 7, LIST_END)
        term.setBackgroundColor(UI.background); term.setTextColor(UI.subtext)
        term.write("[v more]")
    end
end

local function drawActions()
    paintutils.drawFilledBox(1, h - 2, w, h - 2, UI.border)
    term.setCursorPos(1, h - 1)
    term.setBackgroundColor(UI.background)
    term.clearLine()

    local sLabel = scanning and " Scanning... " or " Scan Network "
    local bLabel = " Back "

    local sx = 2
    paintutils.drawFilledBox(sx, h - 1, sx + #sLabel - 1, h - 1, scanning and UI.border or UI.primary)
    term.setCursorPos(sx, h - 1)
    term.setTextColor(scanning and UI.subtext or UI.background)
    term.write(sLabel)
    scanBtn = {x1 = sx, y1 = h - 1, x2 = sx + #sLabel - 1, y2 = h - 1}

    local bx = w - #bLabel
    paintutils.drawFilledBox(bx, h - 1, w, h - 1, UI.border)
    term.setCursorPos(bx, h - 1)
    term.setTextColor(UI.text)
    term.write(bLabel)
    backBtn = {x1 = bx, y1 = h - 1, x2 = w, y2 = h - 1}

    term.setCursorPos(1, h)
    term.setBackgroundColor(UI.background)
    term.clearLine()
    term.setCursorPos(2, h)
    term.setTextColor(UI.subtext)
    term.write("Up/Down: select  |  Enter: scan  |  Backspace: back")
end

local function redraw()
    term.setBackgroundColor(UI.background)
    term.clear()
    drawHeader()
    drawStatus(#results > 0 and (#results .. " server(s) found") or "Press Scan to discover servers.")
    drawList()
    drawActions()
end

local function doScan()
    if scanning then return end
    scanning = true
    results  = {}
    selectedIdx = 1
    scrollOff   = 0
    redraw()
    drawStatus("Scanning for PunOS servers...", UI.primary)

    -- Broadcast a ping on our scan protocol
    -- Servers running .server or publicChat host will NOT respond to this directly,
    -- but we can discover them via rednet.lookup on their specific protocols.
    -- We also send a ping for any server that has netScan open (listenLoop below).
    rednet.broadcast({ type = "punos_ping", from = os.getComputerID() }, SCAN_PROTOCOL)

    -- Collect any punos_scan pong replies (computers with netScan open)
    local seen = {}
    seen[os.getComputerID()] = true

    local deadline = os.clock() + SCAN_TIMEOUT
    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local senderId, msg = rednet.receive(SCAN_PROTOCOL, remaining)
        if senderId and type(msg) == "table" and msg.type == "punos_pong" and not seen[senderId] then
            seen[senderId] = true
            table.insert(results, {
                id      = senderId,
                label   = msg.label or "",
                service = msg.service or "punos",
            })
            drawStatus("Found " .. #results .. " server(s)...", UI.primary)
            drawList()
        end
    end

    -- Query known protocols directly — these work even without ping/pong
    -- because the servers call rednet.host() which registers with the rednet daemon
    local lookups = {
        {proto = "nfp_share", label = "fileshare"},
        {proto = "chat",      label = "chat"},
    }

    for _, entry in ipairs(lookups) do
        -- rednet.lookup with no name returns one ID or nil
        -- We call it in a loop fishing for multiple by name if we know them,
        -- but without names we can only get one. Still useful for the common case.
        local id = rednet.lookup(entry.proto)
        if id and id ~= os.getComputerID() and not seen[id] then
            seen[id] = true
            table.insert(results, {
                id      = id,
                label   = "",
                service = entry.label,
            })
        end
    end

    table.sort(results, function(a, b) return a.id < b.id end)

    scanning = false
    redraw()
    local msg = #results > 0 and (#results .. " server(s) found.") or "No servers found."
    drawStatus(msg, #results > 0 and UI.success or UI.subtext)
end

local function uiLoop()
    redraw()
    while true do
        local e, p1, p2, p3 = os.pullEvent()

        if e == "key" then
            if p1 == keys.up or p1 == keys.w then
                if selectedIdx > 1 then
                    selectedIdx = selectedIdx - 1
                    if selectedIdx - 1 < scrollOff then scrollOff = selectedIdx - 1 end
                    drawList(); drawActions()
                end
            elseif p1 == keys.down or p1 == keys.s then
                if selectedIdx < #results then
                    selectedIdx = selectedIdx + 1
                    if selectedIdx - 1 >= scrollOff + listHeight then scrollOff = selectedIdx - listHeight end
                    drawList(); drawActions()
                end
            elseif p1 == keys.enter then
                doScan()
            elseif p1 == keys.backspace then
                break
            end

        elseif e == "mouse_click" then
            local mx, my = p2, p3
            if mx >= scanBtn.x1 and mx <= scanBtn.x2 and my == scanBtn.y1 then
                doScan()
            elseif mx >= backBtn.x1 and mx <= backBtn.x2 and my == backBtn.y1 then
                break
            else
                for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff) do
                    local y = LIST_START + (i - 1 - scrollOff)
                    if my == y then
                        selectedIdx = i; drawList(); drawActions(); break
                    end
                end
            end

        elseif e == "mouse_scroll" then
            if p1 == 1 and scrollOff + listHeight < #results then
                scrollOff = scrollOff + 1; drawList()
            elseif p1 == -1 and scrollOff > 0 then
                scrollOff = scrollOff - 1; drawList()
            end
        end
    end
end

-- Respond to pings from other scanners while this UI is open
local function listenLoop()
    while true do
        local senderId, msg = rednet.receive(SCAN_PROTOCOL)
        if type(msg) == "table" and msg.type == "punos_ping" then
            rednet.send(senderId, {
                type    = "punos_pong",
                label   = os.getComputerLabel() or "",
                service = "punos_client",
            }, SCAN_PROTOCOL)
        end
    end
end

parallel.waitForAny(uiLoop, listenLoop)

rednet.close(peripheral.getName(modem))
term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1, 1)
shell.run("os/.programs")
