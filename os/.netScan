-- PunOS Network Scanner

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local modem = peripheral.find("modem")
if not modem then
    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    term.setCursorPos(2, 5); term.setTextColor(UI.error);    term.write("No modem found.")
    term.setCursorPos(2, 7); term.setTextColor(UI.subtext);  term.write("Press any key.")
    os.pullEvent("key")
    shell.run("os/.programs")
    return
end

rednet.open(peripheral.getName(modem))

-- Original design: Servers register under standard protocols but use custom naming conventions.
-- rednet.lookup returns all hosts on a protocol as a table when no name given.

local results     = {}
local scanning    = false
local selectedIdx = 1
local scrollOff   = 0

local LIST_START  = 4
local listHeight  = h - LIST_START - 2

local scanBtn = { x1 = 2,     y1 = h, x2 = 10, label = "[ Scan ]" }
local backBtn = { x1 = w - 9, y1 = h, x2 = w,  label = "[ Back ]" }

local function drawHeader()
    term.setBackgroundColor(UI.border)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
end

local function drawFooter()
    term.setBackgroundColor(UI.border)
    paintutils.drawFilledBox(1, h, w, h, UI.border)
    
    term.setCursorPos(scanBtn.x1, scanBtn.y1)
    term.setTextColor(scanning and UI.subtext or UI.primary)
    term.write(scanBtn.label)

    term.setCursorPos(backBtn.x1, backBtn.y1)
    term.setTextColor(UI.error)
    term.write(backBtn.label)
end

local function drawList()
    term.setBackgroundColor(UI.background)
    for y = LIST_START, LIST_START + listHeight do
        term.setCursorPos(1, y)
        term.clearLine()
    end

    if #results == 0 then
        term.setCursorPos(2, LIST_START)
        term.setTextColor(UI.subtext)
        term.write(scanning and "Scanning network..." or "No active servers found.")
        return
    end

    for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
        local r = results[i]
        if r then
            local y = LIST_START + (i - 1 - scrollOff)
            term.setCursorPos(2, y)
            
            if i == selectedIdx then
                term.setBackgroundColor(UI.secondary)
                term.setTextColor(UI.text)
            else
                term.setBackgroundColor(UI.background)
                term.setTextColor(UI.text)
            end

            local label = (r.label and r.label ~= "") and (" (" .. r.label .. ")") or ""
            local line  = "ID: " .. tostring(r.id) .. "  " .. r.service .. label
            line = line .. string.rep(" ", w - #line - 2)
            term.write(line:sub(1, w - 2))
        end
    end
    term.setBackgroundColor(UI.background)
end

local function drawActions()
    local actY = h - 1
    term.setCursorPos(1, actY)
    term.setBackgroundColor(UI.background)
    term.clearLine()

    local r = results[selectedIdx]
    if r and #results > 0 then
        term.setCursorPos(2, actY)
        term.setTextColor(UI.primary)
        term.write("Press ENTER to connect")
    end
end

local function doScan()
    scanning = true
    results  = {}
    selectedIdx = 1
    scrollOff = 0
    drawList()
    drawActions()

    local seen = {}
    
    -- Original design lookup patterns
    local lookups = {
        { proto = "nfp_share", label = "fileshare" },
        { proto = "chat",      label = "chat" }
    }

    for _, entry in ipairs(lookups) do
        -- Fix: CC returns a table array of host IDs when no hostname is passed to rednet.lookup
        local ids = rednet.lookup(entry.proto)
        if ids then
            if type(ids) ~= "table" then ids = {ids} end -- Safe fallback if single ID returned
            
            for _, id in ipairs(ids) do
                if id ~= os.getComputerID() and not seen[id] then
                    seen[id] = true
                    
                    -- To respect your original configuration where servers register unique hostnames,
                    -- we can add them to our visible result list.
                    table.insert(results, {
                        id      = id,
                        label   = "", 
                        service = entry.label
                    })
                end
            end
        end
    end

    scanning = false
    drawList()
    drawActions()
end

local function uiLoop()
    drawHeader()
    drawFooter()
    doScan()

    while true do
        local e, p1, p2, p3 = os.pullEvent()

        if e == "key" then
            if p1 == keys.up and selectedIdx > 1 then
                selectedIdx = selectedIdx - 1
                if selectedIdx - 1 < scrollOff then scrollOff = scrollOff - 1 end
                drawList(); drawActions()
            elseif p1 == keys.down and selectedIdx < #results then
                selectedIdx = selectedIdx + 1
                if selectedIdx - 1 >= scrollOff + listHeight then scrollOff = scrollOff + 1 end
                drawList(); drawActions()
            elseif p1 == keys.enter and #results > 0 then
                local r = results[selectedIdx]
                if r then
                    term.setBackgroundColor(colors.black)
                    term.clear()
                    term.setCursorPos(1, 1)
                    if r.service == "fileshare" then
                        shell.run("os/programs/shareClient.lua", tostring(r.id))
                    elseif r.service == "chat" then
                        -- Connects via original parameters
                        shell.run("os/programs/publicChat.lua", "join", "Server", "User" .. os.getComputerID())
                    end
                    break
                end
            end

        elseif e == "mouse_click" and p1 == 1 then
            local mx, my = p2, p3
            if mx >= scanBtn.x1 and mx <= scanBtn.x2 and my == scanBtn.y1 then
                doScan()
            elseif mx >= backBtn.x1 and mx <= backBtn.x2 and my == backBtn.y1 then
                break
            else
                for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff) do
                    local y = LIST_START + (i - 1 - scrollOff)
                    if my == y then
                        selectedIdx = i; drawList(); drawActions(); break
                    end
                end
            end

        elseif e == "mouse_scroll" then
            if p1 == 1 and scrollOff + listHeight < #results then
                scrollOff = scrollOff + 1; drawList()
            elseif p1 == -1 and scrollOff > 0 then
                scrollOff = scrollOff - 1; drawList()
            end
        end
    end
end

-- Original background listener loop
local function listenLoop()
    while true do
        local senderId, msg = rednet.receive("punos_scan")
        if type(msg) == "table" and msg.type == "punos_ping" then
            rednet.send(senderId, {
                type    = "punos_pong",
                label   = os.getComputerLabel() or "",
                service = "punos_client",
            }, "punos_scan")
        end
    end
end

parallel.waitForAny(uiLoop, listenLoop)

rednet.close(peripheral.getName(modem))
term.setBackgroundColor(colors.black)
term.clear()
term.setCursorPos(1,1)
shell.run("os/.programs")
