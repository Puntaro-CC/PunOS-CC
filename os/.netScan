-- PunOS Network Scanner

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local modem = peripheral.find("modem")
if not modem then
    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    term.setCursorPos(2, 5); term.setTextColor(UI.error);    term.write("No modem found.")
    term.setCursorPos(2, 7); term.setTextColor(UI.subtext);  term.write("Press any key.")
    os.pullEvent("key")
    shell.run("os/.programs")
    return
end

rednet.open(peripheral.getName(modem))

local results     = {}
local scanning    = false
local selectedIdx = 1
local scrollOff   = 0

local LIST_START = 4
local listHeight = h - LIST_START - 2

local scanBtn = { x1 = 2,     x2 = 10, y = h, label = "[ Scan ]" }
local backBtn = { x1 = w - 8, x2 = w,  y = h, label = "[ Back ]" }

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    local info = "ID:" .. os.getComputerID()
    term.setCursorPos(w - #info - 1, 2); term.write(info)
end

local function drawFooter()
    paintutils.drawFilledBox(1, h, w, h, UI.border)
    term.setCursorPos(scanBtn.x1, h)
    term.setTextColor(scanning and UI.subtext or UI.primary)
    term.write(scanBtn.label)
    term.setCursorPos(backBtn.x1, h)
    term.setTextColor(UI.error)
    term.write(backBtn.label)
end

local function drawList()
    term.setBackgroundColor(UI.background)
    for y = LIST_START, LIST_START + listHeight do
        term.setCursorPos(1, y); term.clearLine()
    end

    if #results == 0 then
        term.setCursorPos(2, LIST_START); term.setTextColor(UI.subtext)
        term.write(scanning and "Scanning network..." or "No active servers found.")
        return
    end

    for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
        local r = results[i]
        if r then
            local y = LIST_START + (i - 1 - scrollOff)
            if i == selectedIdx then
                paintutils.drawFilledBox(1, y, w, y, UI.primary)
                term.setCursorPos(2, y); term.setTextColor(UI.background)
            else
                term.setCursorPos(2, y); term.setTextColor(UI.text)
            end
            local label = (r.label and r.label ~= "") and (" (" .. r.label .. ")") or ""
            local line  = "ID:" .. tostring(r.id) .. "  " .. r.service .. label
            if #line > w - 2 then line = line:sub(1, w - 2) end
            term.write(line)
        end
    end
    term.setBackgroundColor(UI.background)
end

local function drawActions()
    local actY = h - 1
    term.setCursorPos(1, actY); term.setBackgroundColor(UI.background); term.clearLine()
    if #results > 0 and results[selectedIdx] then
        term.setCursorPos(2, actY); term.setTextColor(UI.primary)
        term.write("Enter: connect to selected server")
    end
end

local function doScan()
    scanning = true; results = {}; selectedIdx = 1; scrollOff = 0
    drawList(); drawActions()

    local seen = {}
    local lookups = {
        { proto = "nfp_share", label = "File Share" },
        { proto = "chat",      label = "Chat" },
    }

    for _, entry in ipairs(lookups) do
        local ids = rednet.lookup(entry.proto)
        if ids then
            if type(ids) ~= "table" then ids = { ids } end
            for _, id in ipairs(ids) do
                if id ~= os.getComputerID() and not seen[id] then
                    seen[id] = true
                    table.insert(results, { id = id, label = "", service = entry.label, proto = entry.proto })
                end
            end
        end
    end

    scanning = false; drawList(); drawActions()
end

local function connectTo(r)
    rednet.close(peripheral.getName(modem))
    term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
    if r.proto == "nfp_share" then
        shell.run("os/.fileShare")
    elseif r.proto == "chat" then
        -- Strip the "chat_" prefix to get the hostname
        local hostname = r.label ~= "" and r.label or tostring(r.id)
        shell.run("/publicChat.lua", "join", hostname, os.computerLabel() or ("User" .. os.getComputerID()))
    end
end

local function uiLoop()
    term.setBackgroundColor(UI.background); term.clear()
    drawHeader(); drawFooter()
    doScan()

    while true do
        local e, p1, p2, p3 = os.pullEvent()

        if e == "key" then
            if p1 == keys.up and selectedIdx > 1 then
                selectedIdx = selectedIdx - 1
                if selectedIdx - 1 < scrollOff then scrollOff = scrollOff - 1 end
                drawList(); drawActions()
            elseif p1 == keys.down and selectedIdx < #results then
                selectedIdx = selectedIdx + 1
                if selectedIdx - 1 >= scrollOff + listHeight then scrollOff = scrollOff + 1 end
                drawList(); drawActions()
            elseif p1 == keys.enter and #results > 0 and results[selectedIdx] then
                connectTo(results[selectedIdx]); return
            elseif p1 == keys.backspace then
                break
            end

        elseif e == "mouse_click" then
            local mx, my = p2, p3
            if my == h then
                if mx >= scanBtn.x1 and mx <= scanBtn.x2 then
                    doScan()
                elseif mx >= backBtn.x1 and mx <= backBtn.x2 then
                    break
                end
            else
                for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
                    local y = LIST_START + (i - 1 - scrollOff)
                    if my == y then
                        if selectedIdx == i and results[i] then
                            connectTo(results[i]); return
                        else
                            selectedIdx = i; drawList(); drawActions()
                        end
                        break
                    end
                end
            end

        elseif e == "mouse_scroll" then
            if p1 == 1 and scrollOff + listHeight < #results then
                scrollOff = scrollOff + 1; drawList()
            elseif p1 == -1 and scrollOff > 0 then
                scrollOff = scrollOff - 1; drawList()
            end
        end
    end
end

-- Background listener so this computer responds to scans from others
local function listenLoop()
    while true do
        local senderId, msg = rednet.receive("punos_scan")
        if type(msg) == "table" and msg.type == "punos_ping" then
            rednet.send(senderId, {
                type    = "punos_pong",
                label   = os.getComputerLabel() or "",
                service = "punos_client",
            }, "punos_scan")
        end
    end
end

parallel.waitForAny(uiLoop, listenLoop)

rednet.close(peripheral.getName(modem))
term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
shell.run("os/.programs")
