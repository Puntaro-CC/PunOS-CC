-- PunOS Network Scanner

os.pullEvent = os.pullEventRaw

local UI = dofile("/os/loadTheme.lua")
local w, h = term.getSize()

local modem = peripheral.find("modem")
if not modem then
    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    term.setCursorPos(2, 5); term.setTextColor(UI.error);    term.write("No modem found.")
    term.setCursorPos(2, 7); term.setTextColor(UI.subtext);  term.write("Press any key.")
    os.pullEvent("key")
    shell.run("os/.programs")
    return
end

rednet.open(peripheral.getName(modem))

local results     = {}
local scanning    = false
local selectedIdx = 1
local scrollOff   = 0

local LIST_START = 4
local listHeight = h - LIST_START - 2

local scanBtn = { x1 = 2,     x2 = 10, y = h, label = "[ Scan ]" }
local backBtn = { x1 = w - 8, x2 = w,  y = h, label = "[ Back ]" }

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext);  term.write("Network Scanner")
    local info = "ID:" .. os.getComputerID()
    term.setCursorPos(w - #info - 1, 2); term.write(info)
end

local function drawFooter()
    paintutils.drawFilledBox(1, h, w, h, UI.border)
    term.setCursorPos(scanBtn.x1, h)
    term.setTextColor(scanning and UI.subtext or UI.primary)
    term.write(scanBtn.label)
    term.setCursorPos(backBtn.x1, h)
    term.setTextColor(UI.error)
    term.write(backBtn.label)
end

local function drawList()
    term.setBackgroundColor(UI.background)
    for y = LIST_START, LIST_START + listHeight do
        term.setCursorPos(1, y); term.clearLine()
    end

    if #results == 0 then
        term.setCursorPos(2, LIST_START); term.setTextColor(UI.subtext)
        term.write(scanning and "Scanning network..." or "No active servers found.")
        return
    end

    for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
        local r = results[i]
        if r then
            local y = LIST_START + (i - 1 - scrollOff)
            if i == selectedIdx then
                paintutils.drawFilledBox(1, y, w, y, UI.primary)
                term.setCursorPos(2, y); term.setTextColor(UI.background)
            else
                term.setCursorPos(2, y); term.setTextColor(UI.text)
            end
            local line = "ID:" .. tostring(r.id) .. "  " .. r.service .. " - " .. r.hostname
            if #line > w - 2 then line = line:sub(1, w - 2) end
            term.write(line)
        end
    end
    term.setBackgroundColor(UI.background)
end

local function drawActions()
    local actY = h - 1
    term.setCursorPos(1, actY); term.setBackgroundColor(UI.background); term.clearLine()
    if #results > 0 and results[selectedIdx] then
        term.setCursorPos(2, actY); term.setTextColor(UI.primary)
        term.write("Enter: connect to selected server")
    end
end

local function rawLookup(protocol)
    local myID = os.getComputerID()

    rednet.broadcast({
        sType     = "lookup",
        sProtocol = protocol,
        sHostname = nil,
    }, "dns")

    local found = {}
    local seen  = {}
    local timer = os.startTimer(2)

    while true do
        local ev, p1, p2, p3, p4 = os.pullEvent()

        if ev == "timer" and p1 == timer then
            break

        elseif ev == "rednet_message" then
            local senderID, msg, proto = p1, p2, p3
            if proto == "dns" and type(msg) == "table"
            and msg.sType == "lookup response" and msg.sProtocol == protocol
            and senderID ~= myID and not seen[senderID] then
                seen[senderID] = true
                table.insert(found, { id = senderID, hostname = msg.sHostname or tostring(senderID) })
            end

        elseif ev == "modem_message" then
            local channel, replyID, raw = p2, p3, p4
            if channel == myID and replyID ~= myID and type(raw) == "table" then
                local msg = (type(raw.message) == "table") and raw.message or raw
                if msg.sType == "lookup response" and msg.sProtocol == protocol
                and not seen[replyID] then
                    seen[replyID] = true
                    table.insert(found, { id = replyID, hostname = msg.sHostname or tostring(replyID) })
                end
            end
        end
    end

    return found
end

local function doScan()
    scanning = true; results = {}; selectedIdx = 1; scrollOff = 0
    drawList(); drawActions()

    local seen = {}
    local protocols = {
        { proto = "nfp_share", label = "File Share", strip = nil       },
        { proto = "chat",      label = "Chat",       strip = "chat_"   },
    }

    for _, entry in ipairs(protocols) do
        local found = rawLookup(entry.proto)
        for _, r in ipairs(found) do
            if not seen[r.id] then
                seen[r.id] = true
                local hostname = r.hostname
                if entry.strip and hostname:sub(1, #entry.strip) == entry.strip then
                    hostname = hostname:sub(#entry.strip + 1)
                end
                table.insert(results, {
                    id       = r.id,
                    hostname = hostname,
                    service  = entry.label,
                    proto    = entry.proto,
                    foundID  = r.id,
                })
            end
        end
    end

    scanning = false; drawList(); drawActions()
end

-- Upload/download flow that skips server lookup (foundID already known)
local function directUpload(foundID)
    local PROTOCOL = "nfp_share"
    local TYPE_INFO = {
        paint = {ext = ".nfp",    dir = "/paint", label = "Paint image"},
        audio = {ext = ".dfpwm", dir = "/audio",  label = "Audio file"}
    }

    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext); term.write("File Upload")

    term.setTextColor(UI.subtext); term.setCursorPos(2, 4)
    term.write("What type of file?")
    term.setTextColor(UI.text)
    term.setCursorPos(2, 5); term.write("  [1] Paint image  (.nfp)")
    term.setCursorPos(2, 6); term.write("  [2] Audio file   (.dfpwm)")
    term.setCursorPos(2, 8); term.setTextColor(UI.subtext); term.write("Enter 1 or 2:")
    term.setTextColor(UI.text); term.setCursorPos(2, 9)
    local typeChoice = read()

    local fileType
    if typeChoice == "1" then fileType = "paint"
    elseif typeChoice == "2" then fileType = "audio"
    else
        term.setTextColor(UI.error); term.setCursorPos(2, 11); term.write("Invalid choice.")
        sleep(2); return
    end

    local info = TYPE_INFO[fileType]

    -- List local files
    local localFiles = {}
    if fs.exists(info.dir) and fs.isDir(info.dir) then
        for _, f in ipairs(fs.list(info.dir)) do
            if not fs.isDir(info.dir .. "/" .. f) and f:sub(-#info.ext) == info.ext then
                table.insert(localFiles, f)
            end
        end
    end

    term.setCursorPos(2, 11); term.setTextColor(UI.subtext)
    term.write("Your " .. info.label .. " files:")
    local ly = 12
    if #localFiles > 0 then
        for _, f in ipairs(localFiles) do
            if ly > h - 4 then break end
            term.setCursorPos(4, ly); term.setTextColor(UI.text); term.write(f)
            ly = ly + 1
        end
    else
        term.setCursorPos(4, ly); term.setTextColor(UI.subtext); term.write("(none found)")
        ly = ly + 1
    end

    term.setCursorPos(2, ly + 1); term.setTextColor(UI.subtext)
    term.write("Filename (must end in " .. info.ext .. "):")
    term.setTextColor(UI.text); term.setCursorPos(2, ly + 2)
    local filename = read()

    if filename:sub(-#info.ext) ~= info.ext then
        term.setCursorPos(2, ly + 4); term.setTextColor(UI.error)
        term.write("Must end in " .. info.ext .. ". Cancelled.")
        sleep(2); return
    end

    local filepath = info.dir .. "/" .. filename
    if not fs.exists(filepath) then
        term.setCursorPos(2, ly + 4); term.setTextColor(UI.error)
        term.write("File not found: " .. filepath)
        sleep(2); return
    end

    term.setCursorPos(2, ly + 4); term.setTextColor(UI.subtext)
    term.write("Recipient ID (blank = public):")
    term.setTextColor(UI.text); term.setCursorPos(2, ly + 5)
    local recipientInput = read()
    local recipient = nil
    if recipientInput ~= "" then
        recipient = tonumber(recipientInput)
        if not recipient then
            term.setCursorPos(2, ly + 7); term.setTextColor(UI.error)
            term.write("Invalid recipient ID.")
            sleep(2); return
        end
    end

    local file = fs.open(filepath, "r")
    local data = file.readAll()
    file.close()

    term.setCursorPos(2, ly + 7); term.setTextColor(UI.subtext)
    term.write("Uploading...")

    rednet.send(foundID, {
        action    = "upload",
        fileType  = fileType,
        filename  = filename,
        data      = data,
        recipient = recipient
    }, PROTOCOL)

    local id, response = rednet.receive(PROTOCOL, 5)
    term.setCursorPos(2, ly + 9)
    if id == foundID and response and response.success then
        term.setTextColor(UI.success); term.write("Success: " .. response.message)
    else
        term.setTextColor(UI.error)
        term.write("Failed: " .. (response and response.message or "No response"))
    end
    sleep(2)
end

local function directDownload(foundID)
    local PROTOCOL = "nfp_share"
    local TYPE_INFO = {
        paint = {ext = ".nfp",    dir = "/paint", label = "Paint image"},
        audio = {ext = ".dfpwm", dir = "/audio",  label = "Audio file"}
    }

    term.setBackgroundColor(UI.background)
    term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext); term.write("File Download")

    term.setTextColor(UI.subtext); term.setCursorPos(2, 4)
    term.write("What type of file?")
    term.setTextColor(UI.text)
    term.setCursorPos(2, 5); term.write("  [1] Paint image  (.nfp)")
    term.setCursorPos(2, 6); term.write("  [2] Audio file   (.dfpwm)")
    term.setCursorPos(2, 8); term.setTextColor(UI.subtext); term.write("Enter 1 or 2:")
    term.setTextColor(UI.text); term.setCursorPos(2, 9)
    local typeChoice = read()

    local fileType
    if typeChoice == "1" then fileType = "paint"
    elseif typeChoice == "2" then fileType = "audio"
    else
        term.setTextColor(UI.error); term.setCursorPos(2, 11); term.write("Invalid choice.")
        sleep(2); return
    end

    local info = TYPE_INFO[fileType]

    -- Fetch file list from server
    term.setCursorPos(2, 11); term.setTextColor(UI.subtext)
    term.write("Fetching file list...")

    rednet.send(foundID, {action = "list", fileType = fileType}, PROTOCOL)
    local id, response = rednet.receive(PROTOCOL, 5)

    local ly = 12
    if id == foundID and response and response.success then
        term.setCursorPos(2, ly); term.setTextColor(UI.subtext)
        term.write("Available " .. info.label .. " files:")
        ly = ly + 1
        if #response.files == 0 then
            term.setCursorPos(4, ly); term.setTextColor(UI.subtext); term.write("(none available)")
            ly = ly + 1
        else
            for _, fi in ipairs(response.files) do
                if ly > h - 5 then break end
                term.setCursorPos(4, ly)
                if fi.public then term.setTextColor(UI.success) else term.setTextColor(UI.subtext) end
                term.write(fi.name)
                ly = ly + 1
            end
        end
    else
        term.setCursorPos(2, ly); term.setTextColor(UI.error); term.write("Could not fetch list.")
        ly = ly + 1
    end

    term.setCursorPos(2, ly + 1); term.setTextColor(UI.subtext)
    term.write("Filename (must end in " .. info.ext .. "):")
    term.setTextColor(UI.text); term.setCursorPos(2, ly + 2)
    local filename = read()

    if filename:sub(-#info.ext) ~= info.ext then
        term.setCursorPos(2, ly + 4); term.setTextColor(UI.error)
        term.write("Must end in " .. info.ext .. ". Cancelled.")
        sleep(2); return
    end

    if not fs.exists(info.dir) then fs.makeDir(info.dir) end

    rednet.send(foundID, {
        action   = "download",
        fileType = fileType,
        filename = filename
    }, PROTOCOL)

    local dlID, dlResponse = rednet.receive(PROTOCOL, 5)
    term.setCursorPos(2, ly + 4)
    if dlID == foundID and dlResponse and dlResponse.success then
        local file = fs.open(info.dir .. "/" .. filename, "w")
        file.write(dlResponse.data)
        file.close()
        term.setTextColor(UI.success); term.write("Saved to: " .. info.dir .. "/" .. filename)
    else
        local msg = dlResponse and dlResponse.message or "No response"
        term.setTextColor(UI.error); term.write("Failed: " .. msg)
    end
    sleep(2)
end

local function fileSharePrompt()
    term.setBackgroundColor(UI.background); term.clear()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1); term.setTextColor(UI.primary); term.write("PunOS")
    term.setCursorPos(2, 2); term.setTextColor(UI.subtext); term.write("File Share")

    local opts = {
        { label = "Upload",   desc = "Send a file to the server",  key = "upload"   },
        { label = "Download", desc = "Get a file from the server", key = "download" },
        { label = "Back",     desc = "Return to scanner",          key = "back"     },
    }
    local sel  = 1
    local btnW = 24
    local btnX = math.floor((w - btnW) / 2)
    local btns = {}

    local function drawPrompt()
        btns = {}
        for i, opt in ipairs(opts) do
            local y = 5 + (i - 1) * 3
            if i == sel then
                paintutils.drawFilledBox(btnX, y, btnX + btnW - 1, y + 1, UI.primary)
                term.setTextColor(UI.background)
            else
                paintutils.drawFilledBox(btnX, y, btnX + btnW - 1, y + 1, UI.border)
                term.setTextColor(UI.text)
            end
            term.setCursorPos(btnX + 1, y);     term.write(opt.label)
            term.setTextColor(i == sel and UI.background or UI.subtext)
            term.setCursorPos(btnX + 1, y + 1); term.write(opt.desc)
            btns[i] = { x1 = btnX, y1 = y, x2 = btnX + btnW - 1, y2 = y + 1 }
        end
    end

    drawPrompt()

    while true do
        local e, p1, p2, p3 = os.pullEvent()
        if e == "key" then
            if p1 == keys.up   and sel > 1          then sel = sel - 1; drawPrompt()
            elseif p1 == keys.down and sel < #opts  then sel = sel + 1; drawPrompt()
            elseif p1 == keys.enter                 then return opts[sel].key
            elseif p1 == keys.backspace             then return "back" end
        elseif e == "mouse_click" then
            local mx, my = p2, p3
            for i, b in ipairs(btns) do
                if mx >= b.x1 and mx <= b.x2 and my >= b.y1 and my <= b.y2 then
                    if sel == i then return opts[i].key
                    else sel = i; drawPrompt() end
                    break
                end
            end
        end
    end
end

local function connectTo(r)
    if r.proto == "nfp_share" then
        local choice = fileSharePrompt()
        if choice == "back" then return end
        -- Use the direct upload/download functions, passing the already-known server ID
        if choice == "upload" then
            directUpload(r.foundID)
        elseif choice == "download" then
            directDownload(r.foundID)
        end
        return
    elseif r.proto == "chat" then
        rednet.close(peripheral.getName(modem))
        term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
        shell.run("/publicChat.lua", "join", r.hostname,
            os.computerLabel() or ("User" .. os.getComputerID()))
    end
end

local function uiLoop()
    term.setBackgroundColor(UI.background); term.clear()
    drawHeader(); drawFooter()
    doScan()

    while true do
        local e, p1, p2, p3 = os.pullEvent()

        if e == "key" then
            if p1 == keys.up and selectedIdx > 1 then
                selectedIdx = selectedIdx - 1
                if selectedIdx - 1 < scrollOff then scrollOff = scrollOff - 1 end
                drawList(); drawActions()
            elseif p1 == keys.down and selectedIdx < #results then
                selectedIdx = selectedIdx + 1
                if selectedIdx - 1 >= scrollOff + listHeight then scrollOff = scrollOff + 1 end
                drawList(); drawActions()
            elseif p1 == keys.enter and #results > 0 and results[selectedIdx] then
                connectTo(results[selectedIdx])
                if not rednet.isOpen(peripheral.getName(modem)) then
                    rednet.open(peripheral.getName(modem))
                end
                term.setBackgroundColor(UI.background); term.clear()
                drawHeader(); drawFooter(); drawList(); drawActions()
            elseif p1 == keys.backspace then
                break
            end

        elseif e == "mouse_click" then
            local mx, my = p2, p3
            if my == h then
                if mx >= scanBtn.x1 and mx <= scanBtn.x2 then
                    doScan()
                elseif mx >= backBtn.x1 and mx <= backBtn.x2 then
                    break
                end
            else
                for i = 1 + scrollOff, math.min(#results, listHeight + scrollOff + 1) do
                    local y = LIST_START + (i - 1 - scrollOff)
                    if my == y then
                        if selectedIdx == i and results[i] then
                            connectTo(results[i])
                            if not rednet.isOpen(peripheral.getName(modem)) then
                                rednet.open(peripheral.getName(modem))
                            end
                            term.setBackgroundColor(UI.background); term.clear()
                            drawHeader(); drawFooter(); drawList(); drawActions()
                        else
                            selectedIdx = i; drawList(); drawActions()
                        end
                        break
                    end
                end
            end

        elseif e == "mouse_scroll" then
            if p1 == 1 and scrollOff + listHeight < #results then
                scrollOff = scrollOff + 1; drawList()
            elseif p1 == -1 and scrollOff > 0 then
                scrollOff = scrollOff - 1; drawList()
            end
        end
    end
end

local function listenLoop()
    while true do
        local senderId, msg = rednet.receive("punos_scan")
        if type(msg) == "table" and msg.type == "punos_ping" then
            rednet.send(senderId, {
                type    = "punos_pong",
                label   = os.getComputerLabel() or "",
                service = "punos_client",
            }, "punos_scan")
        end
    end
end

parallel.waitForAny(uiLoop, listenLoop)

rednet.close(peripheral.getName(modem))
term.setBackgroundColor(colors.black); term.clear(); term.setCursorPos(1, 1)
shell.run("os/.programs")
