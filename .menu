-- PunOS TARDIS Console
-- Replaces .menu on the tardis kernel.
-- Persistent live dashboard reacting to TARDIS events in real time.

os.pullEvent = os.pullEventRaw

local UI               = dofile("/os/loadTheme.lua")
local nativeTerm       = term.current()  -- save before any redirect
local monitor, tardis, w, h = dofile("/os/loadPeripherals.lua")
local tardisOk         = (tardis ~= nil)
local hasMonitor       = (monitor ~= nil)

-- ---- Safe peripheral call helpers -------------------------------------------

local function safe(fn, ...)
    if not tardisOk then return nil end
    local ok, r = pcall(fn, ...)
    return ok and r or nil
end

local function safeMulti(fn, ...)
    if not tardisOk then return nil end
    local ok, a, b, c, d, e = pcall(fn, ...)
    if ok then return a, b, c, d, e end
    return nil
end

local function shortDim(dim)
    if not dim then return "?" end
    return dim:match(":(.+)$") or dim
end

-- ---- Last entered -----------------------------------------------------------

local ENTRY_FILE = "/.tardis_last_entry"

local function readLastEntry()
    if not fs.exists(ENTRY_FILE) then return nil end
    local f = fs.open(ENTRY_FILE, "r")
    local v = f.readAll():gsub("%s+$", "")
    f.close()
    return v ~= "" and v or nil
end

local function saveLastEntry(player)
    local stamp = "Day " .. os.day() .. " | " .. textutils.formatTime(os.time(), false)
    local entry = (player and player ~= "" and player or "unknown") .. " - " .. stamp
    local f = fs.open(ENTRY_FILE, "w")
    f.write(entry)
    f.close()
end

local lastEntry = readLastEntry()

-- ---- Header -----------------------------------------------------------------

local function drawHeader()
    paintutils.drawFilledBox(1, 1, w, 2, UI.border)
    term.setCursorPos(2, 1)
    term.setTextColor(UI.primary)
    term.write("PunOS")
    term.setCursorPos(8, 1)
    term.setTextColor(UI.text)
    term.write("TARDIS Console")

    local statusText = tardisOk and "ONLINE" or "NO SIGNAL"
    local statusCol  = tardisOk and UI.success or UI.error
    term.setCursorPos(w - #statusText - 1, 1)
    term.setBackgroundColor(UI.border)
    term.setTextColor(statusCol)
    term.write(statusText)

    term.setCursorPos(2, 2)
    term.setTextColor(UI.subtext)
    term.write(textutils.formatTime(os.time(), false))
    term.setCursorPos(w - 9, 2)
    term.write("Day " .. os.day())
end

-- ---- Utility ----------------------------------------------------------------

local function clearBody()
    for y = 3, h - 2 do
        term.setCursorPos(1, y)
        term.setBackgroundColor(UI.background)
        term.clearLine()
    end
end

local function sectionBar(y, label)
    paintutils.drawFilledBox(1, y, w, y, UI.border)
    term.setCursorPos(2, y)
    term.setTextColor(UI.primary)
    term.write(label)
end

-- ---- Status (flat, for small screen) ----------------------------------------

local function drawStatusFlat()
    clearBody()

    if not tardisOk then
        local msgs = {
            "No TARDIS peripheral detected.",
            "Make sure this computer is inside",
            "the TARDIS dimension, then reboot.",
        }
        local startY = math.floor(h / 2) - 1
        for i, msg in ipairs(msgs) do
            term.setCursorPos(math.floor((w - #msg) / 2), startY + i - 1)
            term.setTextColor(i == 1 and UI.error or UI.subtext)
            term.write(msg)
        end
        return
    end

    local inFlight   = safe(tardis.isInFlight)
    local isLanding  = safe(tardis.getIsLanding)
    local isCrashing = safe(tardis.getIsCrashing)
    local onCooldown = safe(tardis.getIsOnCooldown)
    local canBegin   = safe(tardis.canBeginFlight)
    local canEnd     = safe(tardis.canEndFlight)
    local inDanger   = safe(tardis.isInDangerZone)
    local flightEvt  = safe(tardis.getFlightEventActive)
    local evtControl = safe(tardis.getFlightEventControl)
    local reqEvents  = safe(tardis.getRequiredFlightEvents) or 0
    local doneEvents = safe(tardis.getRespondedFlightEvents) or 0
    local flightPct  = safe(tardis.getFlightPercent) or 0
    local intOpen    = safe(tardis.getInternalDoorOpen)
    local intLocked, extLocked = safeMulti(tardis.getDoorLocked)
    local shellTheme = safe(tardis.getExteriorTheme) or "unknown"
    local cx, cy, cz, cFacing, cDim = safeMulti(tardis.getLastKnownLocation)
    local tx2, ty2, tz2, tFacing, tDim = safeMulti(tardis.getTargetLocation)

    local row = 3

    -- Flight status bar
    local flightLabel, flightCol
    if isCrashing     then flightLabel = "!! CRASHING !!"; flightCol = UI.error
    elseif onCooldown then flightLabel = "COOLDOWN";       flightCol = UI.error
    elseif inDanger   then flightLabel = "DANGER ZONE";    flightCol = UI.error
    elseif isLanding  then flightLabel = "LANDING";        flightCol = UI.primary
    elseif inFlight   then flightLabel = "IN FLIGHT";      flightCol = UI.primary
    elseif canBegin   then flightLabel = "READY";          flightCol = UI.success
    else                   flightLabel = "LANDED";         flightCol = UI.success
    end

    sectionBar(row, "FLIGHT  ")
    term.setTextColor(flightCol)
    term.write(flightLabel)
    if inFlight then
        local pct = math.floor(flightPct * 100) .. "%"
        term.setCursorPos(w - #pct - 1, row)
        term.setTextColor(UI.primary)
        term.write(pct)
    end
    row = row + 1

    if inFlight then
        local barW   = w - 4
        local filled = math.floor(barW * flightPct)
        if filled > 0 then
            paintutils.drawFilledBox(3, row, 2 + filled, row, UI.primary)
        end
        if filled < barW then
            paintutils.drawFilledBox(3 + filled, row, 3 + barW - 1, row, UI.border)
        end
        row = row + 1
    end

    if inFlight and (inDanger or flightEvt) then
        paintutils.drawFilledBox(1, row, w, row, UI.error)
        term.setCursorPos(2, row)
        term.setBackgroundColor(UI.error)
        term.setTextColor(UI.background)
        if inDanger then
            term.write("DANGER: Complete danger zone events now!")
        elseif flightEvt and evtControl then
            term.write("Interact: " .. evtControl .. "  (" .. doneEvents .. "/" .. reqEvents .. ")")
        end
        row = row + 1
    end

    sectionBar(row, "LOCATION"); row = row + 1

    term.setBackgroundColor(UI.background)
    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext)
    term.write("Current  ")
    term.setTextColor(UI.text)
    if cx then
        local loc = cx.." "..cy.." "..cz.."  "..shortDim(cDim).."  "..(cFacing or "?")
        term.write(loc:sub(1, w - 12))
    else term.write("unknown") end
    row = row + 1

    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext)
    term.write("Target   ")
    term.setTextColor(UI.text)
    if tx2 then
        local loc = tx2.." "..ty2.." "..tz2.."  "..shortDim(tDim).."  "..(tFacing or "?")
        term.write(loc:sub(1, w - 12))
    else
        term.setTextColor(UI.subtext)
        term.write("not set")
    end
    row = row + 1

    sectionBar(row, "SYSTEMS"); row = row + 1

    term.setBackgroundColor(UI.background)
    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext)   term.write("Doors    ")
    term.setTextColor(intOpen and UI.error or UI.success)
    term.write(intOpen and "Open  " or "Closed")
    term.setTextColor(UI.subtext)   term.write("  Lock ")
    term.setTextColor(intLocked and UI.error or UI.success)
    term.write(intLocked and "Locked" or "Free  ")
    term.setTextColor(UI.subtext)   term.write("  Ext ")
    term.setTextColor(extLocked and UI.error or UI.success)
    term.write(extLocked and "Locked" or "Free")
    row = row + 1

    term.setCursorPos(2, row)
    term.setTextColor(UI.subtext) term.write("Shell    ")
    term.setTextColor(UI.text)    term.write(shellTheme)
    row = row + 1

    -- Last entered
    if lastEntry and row <= h - 3 then
        term.setCursorPos(2, row)
        term.setBackgroundColor(UI.background)
        term.setTextColor(UI.subtext)
        term.write("Last in  ")
        term.setTextColor(UI.text)
        local entry = lastEntry:sub(1, w - 12)
        term.write(entry)
        row = row + 1
    end

    if row <= h - 3 then
        term.setCursorPos(2, row)
        term.setBackgroundColor(UI.background)
        if not safe(tardis.getCanUseControls) then
            term.setTextColor(UI.error)
            term.write("Controls unavailable.")
        elseif canBegin and not inFlight then
            term.setTextColor(UI.success)
            term.write("Ready. Set destination in Navigate.")
        elseif canEnd and inFlight then
            term.setTextColor(UI.primary)
            term.write("Can land. Navigate > End Flight.")
        end
    end
end

-- ---- Status (monitor layout with curved button panels) ----------------------

-- Button definitions
local LEFT_BTNS = {
    { label = "Navigate",  action = function() return "os/.tardisNav"   end },
    { label = "Doors",     action = function() return "os/.tardisDoors" end },
    { label = "Shell",     action = function() return "os/.tardisShell" end },
    { label = "Programs",  action = function() return "os/.programs"    end },
}
local RIGHT_BTNS = {
    { label = "Cmd Line",  action = function() return "os/.command"         end },
    { label = "Lock Door", action = function()
        if tardisOk then
            local _, ext = safeMulti(tardis.getDoorLocked)
            pcall(tardis.setDoorLocked, not ext)
        end
    end },
    { label = "Settings",  action = function() return "os/.settings"        end },
    { label = "Uninstall", action = function() return "os/.UninstallDialog" end },
}

local btnRegions = {}  -- {x1,y1,x2,y2, action}

local function drawStatusMonitor()
    clearBody()

    -- Layout constants
    local BTN_W   = 14   -- button width
    local BTN_H   = 2    -- button height
    local BTN_GAP = 1    -- gap between buttons
    local BODY_TOP = 3
    local BODY_BOT = h - 2

    -- Curve offsets per button index (0=top, 3=bottom)
    -- Creates an inward arc: edges indent more than center
    local OFFSETS = {[0]=3, [1]=1, [2]=1, [3]=3}

    btnRegions = {}

    -- Total button area height
    local totalBtnH = #LEFT_BTNS * (BTN_H + BTN_GAP) - BTN_GAP
    local btnStartY = BODY_TOP + math.floor(((BODY_BOT - BODY_TOP) - totalBtnH) / 2)

    -- Draw left and right button columns
    for i = 1, #LEFT_BTNS do
        local off  = OFFSETS[i - 1] or 0
        local y    = btnStartY + (i - 1) * (BTN_H + BTN_GAP)
        local lx1  = 1 + off
        local lx2  = lx1 + BTN_W - 1
        local rx2  = w - off
        local rx1  = rx2 - BTN_W + 1

        -- Left button
        paintutils.drawFilledBox(lx1, y, lx2, y + BTN_H - 1, UI.border)
        paintutils.drawFilledBox(lx1, y, lx2, y, UI.primary)
        term.setCursorPos(lx1 + 1, y)
        term.setBackgroundColor(UI.primary)
        term.setTextColor(UI.fgDark)
        local ll = LEFT_BTNS[i].label
        if #ll > BTN_W - 2 then ll = ll:sub(1, BTN_W - 2) end
        term.write(ll)
        table.insert(btnRegions, {x1=lx1, y1=y, x2=lx2, y2=y+BTN_H-1, idx=i, side="left"})

        -- Right button
        paintutils.drawFilledBox(rx1, y, rx2, y + BTN_H - 1, UI.border)
        paintutils.drawFilledBox(rx1, y, rx2, y, UI.primary)
        term.setCursorPos(rx1 + 1, y)
        term.setBackgroundColor(UI.primary)
        term.setTextColor(UI.fgDark)
        local rl = RIGHT_BTNS[i].label
        if #rl > BTN_W - 2 then rl = rl:sub(1, BTN_W - 2) end
        term.write(rl)
        table.insert(btnRegions, {x1=rx1, y1=y, x2=rx2, y2=y+BTN_H-1, idx=i, side="right"})
    end

    -- Determine the center panel bounds based on the widest button offset
    local minOff = OFFSETS[1] or 1  -- narrowest gap (center buttons)
    local panelX1 = 1 + minOff + BTN_W + 1
    local panelX2 = w - minOff - BTN_W - 1
    local panelW  = panelX2 - panelX1

    if not tardisOk then
        local msg = "No TARDIS peripheral detected."
        term.setCursorPos(math.floor((w - #msg) / 2), math.floor(h / 2))
        term.setTextColor(UI.error)
        term.write(msg)
        return
    end

    -- Gather state
    local inFlight   = safe(tardis.isInFlight)
    local isLanding  = safe(tardis.getIsLanding)
    local isCrashing = safe(tardis.getIsCrashing)
    local onCooldown = safe(tardis.getIsOnCooldown)
    local canBegin   = safe(tardis.canBeginFlight)
    local canEnd     = safe(tardis.canEndFlight)
    local inDanger   = safe(tardis.isInDangerZone)
    local flightEvt  = safe(tardis.getFlightEventActive)
    local evtControl = safe(tardis.getFlightEventControl)
    local reqEvents  = safe(tardis.getRequiredFlightEvents) or 0
    local doneEvents = safe(tardis.getRespondedFlightEvents) or 0
    local flightPct  = safe(tardis.getFlightPercent) or 0
    local intOpen    = safe(tardis.getInternalDoorOpen)
    local intLocked, extLocked = safeMulti(tardis.getDoorLocked)
    local shellTheme = safe(tardis.getExteriorTheme) or "unknown"
    local cx, cy, cz, cFacing, cDim = safeMulti(tardis.getLastKnownLocation)
    local tx2, ty2, tz2, tFacing, tDim = safeMulti(tardis.getTargetLocation)

    -- Center panel content
    local function pline(y, label, val, valCol)
        if y > BODY_BOT then return end
        term.setCursorPos(panelX1, y)
        term.setBackgroundColor(UI.background)
        for x = panelX1, panelX2 do
            term.setCursorPos(x, y)
            term.write(" ")
        end
        term.setCursorPos(panelX1 + 1, y)
        term.setTextColor(UI.subtext)
        term.write(label)
        term.setTextColor(valCol or UI.text)
        local val2 = tostring(val or "")
        if #val2 > panelW - #label - 2 then val2 = val2:sub(1, panelW - #label - 2) end
        term.write(val2)
    end

    local function psection(y, label)
        if y > BODY_BOT then return end
        paintutils.drawFilledBox(panelX1, y, panelX2, y, UI.border)
        term.setCursorPos(panelX1 + 1, y)
        term.setTextColor(UI.primary)
        term.write(label)
    end

    local flightLabel, flightCol
    if isCrashing     then flightLabel = "CRASHING";    flightCol = UI.error
    elseif onCooldown then flightLabel = "COOLDOWN";    flightCol = UI.error
    elseif inDanger   then flightLabel = "DANGER ZONE"; flightCol = UI.error
    elseif isLanding  then flightLabel = "LANDING";     flightCol = UI.primary
    elseif inFlight   then flightLabel = "IN FLIGHT";   flightCol = UI.primary
    elseif canBegin   then flightLabel = "READY";       flightCol = UI.success
    else                   flightLabel = "LANDED";      flightCol = UI.success
    end

    local row = btnStartY

    psection(row, "FLIGHT"); row = row + 1
    pline(row, "Status   ", flightLabel, flightCol); row = row + 1

    if inFlight then
        local barW   = panelW - 4
        local filled = math.floor(barW * flightPct)
        if filled > 0 then
            paintutils.drawFilledBox(panelX1 + 2, row, panelX1 + 1 + filled, row, UI.primary)
        end
        if filled < barW then
            paintutils.drawFilledBox(panelX1 + 2 + filled, row, panelX1 + 1 + barW, row, UI.border)
        end
        row = row + 1
    end

    if inFlight and (inDanger or flightEvt) then
        paintutils.drawFilledBox(panelX1, row, panelX2, row, UI.error)
        term.setCursorPos(panelX1 + 1, row)
        term.setBackgroundColor(UI.error)
        term.setTextColor(UI.background)
        if inDanger then
            term.write("DANGER ZONE — complete events now")
        elseif flightEvt and evtControl then
            term.write("Interact: "..evtControl.." ("..doneEvents.."/"..reqEvents..")")
        end
        row = row + 1
    end

    psection(row, "LOCATION"); row = row + 1
    pline(row, "Current  ", cx and (cx.." "..cy.." "..cz.."  "..shortDim(cDim).."  "..(cFacing or "?")) or "unknown"); row = row + 1
    pline(row, "Target   ", tx2 and (tx2.." "..ty2.." "..tz2.."  "..shortDim(tDim).."  "..(tFacing or "?")) or "not set", tx2 and UI.text or UI.subtext); row = row + 1

    psection(row, "SYSTEMS"); row = row + 1
    pline(row, "Doors    ", intOpen and "Open" or "Closed", intOpen and UI.error or UI.success); row = row + 1
    pline(row, "Int Lock ", intLocked and "Locked" or "Free", intLocked and UI.error or UI.success); row = row + 1
    pline(row, "Ext Lock ", extLocked and "Locked" or "Free", extLocked and UI.error or UI.success); row = row + 1
    pline(row, "Shell    ", shellTheme); row = row + 1
    if lastEntry then
        pline(row, "Last in  ", lastEntry:sub(1, panelW - 12)); row = row + 1
    end
end

-- ---- Nav bar (small screen only) --------------------------------------------

local navBounds = {}

local function drawNav()
    paintutils.drawFilledBox(1, h - 1, w, h - 1, UI.border)
    local labels = { " Navigate ", " Doors ", " Shell ", " Programs ", " Off " }
    local x = 2
    navBounds = {}
    for i, label in ipairs(labels) do
        local x2 = x + #label - 1
        term.setCursorPos(x, h - 1)
        term.setBackgroundColor(UI.border)
        term.setTextColor(UI.text)
        term.write(label)
        navBounds[i] = {x, x2}
        x = x2 + 1
    end
    term.setCursorPos(1, h)
    term.setBackgroundColor(UI.background)
    term.setTextColor(UI.subtext)
    term.clearLine()
    term.write(" Click nav or press 1-5")
end

-- ---- Action dispatch --------------------------------------------------------

local function runApp(path)
    -- For interactive text programs, restore native terminal if on monitor
    local useNative = hasMonitor and (
        path == "os/.command" or
        path == "os/.programs" or
        path == "os/.UninstallDialog"
    )
    if useNative then
        term.redirect(nativeTerm)
    end
    term.setBackgroundColor(colors.black)
    term.clear()
    term.setCursorPos(1, 1)
    shell.run(path)
    if useNative and hasMonitor then
        term.redirect(monitor)
        monitor.setTextScale(0.5)
    end
    term.setBackgroundColor(UI.background)
    term.clear()
    drawHeader()
    if hasMonitor then
        drawStatusMonitor()
    else
        drawStatusFlat()
        drawNav()
    end
end

local navActions = {
    function() runApp("os/.tardisNav")   end,
    function() runApp("os/.tardisDoors") end,
    function() runApp("os/.tardisShell") end,
    function() runApp("os/.programs")    end,
    function() os.shutdown()             end,
}

local function handleBtnClick(mx, my)
    -- Monitor button regions
    for _, btn in ipairs(btnRegions) do
        if mx >= btn.x1 and mx <= btn.x2 and my >= btn.y1 and my <= btn.y2 then
            local def = btn.side == "left" and LEFT_BTNS[btn.idx] or RIGHT_BTNS[btn.idx]
            if def then
                local result = def.action()
                if type(result) == "string" then
                    runApp(result)
                else
                    -- Inline action (e.g. begin/end flight) — just redraw
                    drawStatusMonitor()
                end
            end
            return true
        end
    end
    return false
end

-- ---- Initial draw -----------------------------------------------------------

term.setBackgroundColor(UI.background)
term.clear()
drawHeader()
if hasMonitor then
    drawStatusMonitor()
else
    drawStatusFlat()
    drawNav()
end

local clockTimer  = os.startTimer(1)
local statusTimer = os.startTimer(0.5)

-- ---- Event loop -------------------------------------------------------------

while true do
    local e, p1, p2, p3 = os.pullEvent()

    if e == "timer" then
        if p1 == clockTimer then
            drawHeader()
            clockTimer = os.startTimer(1)
        elseif p1 == statusTimer then
            if hasMonitor then drawStatusMonitor() else drawStatusFlat() end
            statusTimer = os.startTimer(0.5)
        end

    elseif e == "onTakeOff" or e == "onLand" or e == "onCrashed"
        or e == "onDoorOpened" or e == "onDoorClosed"
        or e == "onShellChanged" then
        if hasMonitor then drawStatusMonitor() else drawStatusFlat() end

    elseif e == "onTardisEntered" then
        -- player name may arrive as p1 or p2 depending on Handles version
        local player = (type(p1) == "string" and p1 ~= "") and p1
                    or (type(p2) == "string" and p2 ~= "") and p2
                    or nil
        saveLastEntry(player)
        lastEntry = readLastEntry()
        if hasMonitor then drawStatusMonitor() else drawStatusFlat() end

    elseif e == "mouse_click" or e == "monitor_touch" then
        local mx, my = p2, p3
        if hasMonitor then
            handleBtnClick(mx, my)
        else
            if my == h - 1 then
                for i, bounds in ipairs(navBounds) do
                    if mx >= bounds[1] and mx <= bounds[2] then
                        navActions[i]()
                        clockTimer  = os.startTimer(1)
                        statusTimer = os.startTimer(0.5)
                        break
                    end
                end
            end
        end

    elseif e == "key" then
        local numKeys = { keys.one, keys.two, keys.three, keys.four, keys.five }
        for i, k in ipairs(numKeys) do
            if p1 == k then
                if hasMonitor then
                    -- Number keys map to left buttons on monitor
                    local def = LEFT_BTNS[i]
                    if def then
                        local result = def.action()
                        if type(result) == "string" then runApp(result)
                        else drawStatusMonitor() end
                    end
                else
                    navActions[i]()
                end
                clockTimer  = os.startTimer(1)
                statusTimer = os.startTimer(0.5)
                break
            end
        end
    end
end
