-- PunOS File Share Server v5.2

local PROTOCOL    = "nfp_share"
local SCAN_PROTOCOL = "punos_scan"
local CONFIG_FILE = "/.server_config"
local DIR_PAINT   = "/.server_files/paint"
local DIR_AUDIO   = "/.server_files/audio"

local TYPE_EXT = {
    paint = ".nfp",
    audio = ".dfpwm"
}

local function dirForType(fileType)
    if fileType == "paint" then return DIR_PAINT
    elseif fileType == "audio" then return DIR_AUDIO
    end
    return nil
end

local modem = peripheral.find("modem") or error("No modem found!")
rednet.open(peripheral.getName(modem))

for _, dir in pairs({DIR_PAINT, DIR_AUDIO}) do
    if not fs.exists(dir) then fs.makeDir(dir) end
end

term.clear()
term.setTextColor(colors.orange)
local w, h = term.getSize()
local title = "PUNOS FILE SHARE SERVER v5.2"
term.setCursorPos(math.floor((w - #title) / 2), 2)
print(title)
term.setCursorPos(1, 3)
print(string.rep("=", w))
term.setTextColor(colors.white)

local serverID
local configExists = fs.exists(CONFIG_FILE)

if configExists then
    local f = fs.open(CONFIG_FILE, "r")
    serverID = f.readAll()
    f.close()
    print("")
    term.setTextColor(colors.lime)
    print("Loaded saved server ID: " .. serverID)
else
    serverID = "FS_SERVER_" .. tostring(os.getComputerID())
    local f = fs.open(CONFIG_FILE, "w")
    f.write(serverID)
    f.close()
    print("")
    term.setTextColor(colors.yellow)
    print("Generated new server ID: " .. serverID)
end

-- Host via standard CC Rednet lookup daemon daemon
rednet.host(PROTOCOL, serverID)
term.setTextColor(colors.lightGray)
print("Registered host under protocol '" .. PROTOCOL .. "'")
print("Listening for incoming requests...\n")
term.setTextColor(colors.white)

local function log(color, message)
    local oldColor = term.getTextColor()
    term.setTextColor(color)
    print(os.date("[%H:%M:%S] ") .. message)
    term.setTextColor(oldColor)
end

local function saveFileToDisk(fileType, filename, data)
    local dir = dirForType(fileType)
    if not dir then return false end
    local path = fs.combine(dir, filename .. TYPE_EXT[fileType])
    local f = fs.open(path, "w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

local function loadFileFromDisk(fileType, filename)
    local dir = dirForType(fileType)
    if not dir then return nil end
    local path = fs.combine(dir, filename .. TYPE_EXT[fileType])
    if not fs.exists(path) then return nil end
    local f = fs.open(path, "r")
    if not f then return nil end
    local data = f.readAll()
    f.close()
    return data
end

local function deleteFileFromDisk(fileType, filename)
    local dir = dirForType(fileType)
    if not dir then return false end
    local path = fs.combine(dir, filename .. TYPE_EXT[fileType])
    if fs.exists(path) then
        fs.delete(path)
        return true
    end
    return false
end

-- Server database mock configuration loading
local store = {}
local function rebuildStore()
    store = {}
    for _, fType in pairs({"paint", "audio"}) do
        local dir = dirForType(fType)
        local files = fs.list(dir)
        for _, file in ipairs(files) do
            local cleanName = file:gsub("%.nfp$", ""):gsub("%.dfpwm$", "")
            store[cleanName] = { uploader = 0, data = "disk_stored", type = fType }
        end
    end
end
rebuildStore()

local function mainServerLoop()
    while true do
        local senderID, message, protocol = rednet.receive(PROTOCOL)
        if type(message) == "table" and message.action then
            local action = message.action
            local fileType = message.fileType

            if action == "upload" then
                local filename = message.filename
                if store[filename] then
                    rednet.send(senderID, {success = false, message = "File already exists"}, PROTOCOL)
                else
                    store[filename] = {
                        uploader  = senderID,
                        recipient = message.recipient, -- nil if public
                        data      = message.data,
                        type      = fileType
                    }
                    saveFileToDisk(fileType, filename, message.data)
                    local visibility = message.recipient and ("PRIVATE to ID " .. message.recipient) or "PUBLIC"
                    log(colors.lime, "[UPLOAD:" .. fileType .. "] " .. filename .. " (" .. visibility .. ") from ID:" .. senderID)
                    rednet.send(senderID, {success = true, message = "Uploaded successfully"}, PROTOCOL)
                end

            elseif action == "download" then
                local filename = message.filename
                local fileData = store[filename]
                
                -- Check disk lazy fallback
                if not fileData then
                    local checkedData = loadFileFromDisk("paint", filename) or loadFileFromDisk("audio", filename)
                    if checkedData then
                        rebuildStore()
                        fileData = store[filename]
                    end
                else
                    if fileData.data == "disk_stored" then
                        fileData.data = loadFileFromDisk(fileData.type, filename)
                    end
                end

                if not fileData then
                    rednet.send(senderID, {success = false, message = "File not found"}, PROTOCOL)
                elseif fileData.recipient and fileData.recipient ~= senderID and fileData.uploader ~= senderID then
                    rednet.send(senderID, {success = false, message = "Access denied"}, PROTOCOL)
                else
                    log(colors.cyan, "[DOWNLOAD:" .. fileData.type .. "] " .. filename)
                    rednet.send(senderID, {success = true, data = fileData.data, filename = filename}, PROTOCOL)
                    if fileData.recipient then
                        store[filename] = nil
                        deleteFileFromDisk(fileData.type, filename)
                        log(colors.gray, "[REMOVED] " .. filename .. " (one-time)")
                    end
                end

            elseif action == "list" then
                local fileList = {}
                for name, dataEntry in pairs(store) do
                    if not dataEntry.recipient or dataEntry.recipient == senderID or dataEntry.uploader == senderID then
                        table.insert(fileList, {name = name, public = not dataEntry.recipient})
                    end
                end
                log(colors.yellow, "[LIST] Request from ID:" .. senderID)
                rednet.send(senderID, {success = true, files = fileList}, PROTOCOL)

            elseif action == "delete" then
                local filename = message.filename
                local fileData = store[filename]
                if not fileData then
                    rednet.send(senderID, {success = false, message = "File not found"}, PROTOCOL)
                elseif fileData.uploader ~= senderID then
                    rednet.send(senderID, {success = false, message = "Not authorised"}, PROTOCOL)
                else
                    local savedType = fileData.type
                    store[filename] = nil
                    deleteFileFromDisk(savedType, filename)
                    log(colors.orange, "[DELETE:" .. savedType .. "] " .. filename)
                    rednet.send(senderID, {success = true, message = "File deleted"}, PROTOCOL)
                end
            end
        end
    end
end

local function scanListenerLoop()
    while true do
        local senderId, msg = rednet.receive(SCAN_PROTOCOL)
        if type(msg) == "table" and msg.type == "punos_ping" then
            rednet.send(senderId, {
                type    = "punos_pong",
                label   = os.getComputerLabel() or "File Share",
                service = "fileshare",
            }, SCAN_PROTOCOL)
        end
    end
end

parallel.waitForAny(mainServerLoop, scanListenerLoop)
